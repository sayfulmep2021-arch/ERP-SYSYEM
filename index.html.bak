                                    <text x="45" y="109" font-size="9" fill="#64748b" font-weight="800" text-anchor="end">30,000</text>
                                    <text x="45" y="149" font-size="9" fill="#64748b" font-weight="800" text-anchor="end">20,000</text>
                                    <text x="45" y="189" font-size="9" fill="#64748b" font-weight="800" text-anchor="end">10,000</text>
                                    <text x="45" y="228" font-size="9" fill="#94a3b8" font-weight="800" text-anchor="end">0</text>

                                    <!-- Vertical Guide Markers per Month -->
                                    <line x1="75" y1="25" x2="75" y2="225" stroke="#f8fafc" stroke-width="1"/>
                                    <line x1="135" y1="25" x2="135" y2="225" stroke="#f8fafc" stroke-width="1"/>
                                    <line x1="195" y1="25" x2="195" y2="225" stroke="#f8fafc" stroke-width="1"/>
