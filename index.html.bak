                                    <line x1="375" y1="25" x2="375" y2="225" stroke="#f8fafc" stroke-width="1"/>
                                    <line x1="435" y1="25" x2="435" y2="225" stroke="#f8fafc" stroke-width="1"/>
                                    <line x1="495" y1="25" x2="495" y2="225" stroke="#f8fafc" stroke-width="1"/>
