                                    <line x1="675" y1="25" x2="675" y2="225" stroke="#f8fafc" stroke-width="1"/>
                                    <line x1="735" y1="25" x2="735" y2="225" stroke="#f8fafc" stroke-width="1"/>

                                    <!-- Area Fill under Production Achievement Curve -->
                                    <path d="M 75 81 C 105 85, 115 125, 135 125 C 165 125, 175 115, 195 115 C 225 115, 235 138, 255 138 C 285 138, 295 155, 315 155 C 345 155, 355 165, 375 165 C 405 165, 415 145, 435 145 C 465 145, 475 110, 495 110 C 525 110, 535 78, 555 78 C 585 78, 595 58, 615 58 C 645 58, 655 45, 675 45 C 705 45, 715 65, 735 65 L 735 225 L 75 225 Z" fill="url(#yearlyAchieveAreaGrad)"/>

                                    <!-- Target Curve (Amber Line with dash) -->
                                    <path d="M 75 73 C 105 69, 115 65, 135 65 C 165 65, 175 81, 195 81 C 225 81, 235 97, 255 97 C 285 97, 295 113, 315 113 C 345 113, 355 125, 375 125 C 405 125, 415 105, 435 105 C 465 105, 475 73, 495 73 C 525 73, 535 45, 555 45 C 585 45, 595 33, 615 33 C 645 33, 655 25, 675 25 C 705 25, 715 41, 735 41" fill="none" stroke="url(#yearlyTargetLineGrad)" stroke-width="2.8" stroke-dasharray="6,4" stroke-linecap="round"/>

                                    <!-- Achievement Curve (Solid Sky Blue Line with Glow) -->
                                    <path d="M 75 81 C 105 85, 115 125, 135 125 C 165 125, 175 115, 195 115 C 225 115, 235 138, 255 138 C 285 138, 295 155, 315 155 C 345 155, 355 165, 375 165 C 405 165, 415 145, 435 145 C 465 145, 475 110, 495 110 C 525 110, 535 78, 555 78 C 585 78, 595 58, 615 58 C 645 58, 655 45, 675 45 C 705 45, 715 65, 735 65" fill="none" stroke="url(#yearlyAchieveLineGrad)" stroke-width="3.2" stroke-linecap="round" filter="url(#shadowAchieve)"/>

                                    <!-- Target Milestone Circles (Amber) -->
                                    <circle cx="75" cy="73" r="3.5" fill="#ffffff" stroke="#d97706" stroke-width="2"><title>Jul-26 Target: 38,000 PCS</title></circle>
                                    <circle cx="135" cy="65" r="4.5" fill="#f59e0b" stroke="#ffffff" stroke-width="2"><title>Aug-26 Target: 40,000 PCS (Active Month)</title></circle>
                                    <circle cx="195" cy="81" r="3.5" fill="#ffffff" stroke="#d97706" stroke-width="2"><title>Sep-26 Target: 36,000 PCS</title></circle>
                                    <circle cx="255" cy="97" r="3.5" fill="#ffffff" stroke="#d97706" stroke-width="2"><title>Oct-26 Target: 32,000 PCS</title></circle>
                                    <circle cx="315" cy="113" r="3.5" fill="#ffffff" stroke="#d97706" stroke-width="2"><title>Nov-26 Target: 28,000 PCS</title></circle>
                                    <circle cx="375" cy="125" r="3.5" fill="#ffffff" stroke="#d97706" stroke-width="2"><title>Dec-26 Target: 25,000 PCS</title></circle>
                                    <circle cx="435" cy="105" r="3.5" fill="#ffffff" stroke="#d97706" stroke-width="2"><title>Jan-27 Target: 30,000 PCS</title></circle>
                                    <circle cx="495" cy="73" r="3.5" fill="#ffffff" stroke="#d97706" stroke-width="2"><title>Feb-27 Target: 38,000 PCS</title></circle>
                                    <circle cx="555" cy="45" r="3.5" fill="#ffffff" stroke="#d97706" stroke-width="2"><title>Mar-27 Target: 45,000 PCS</title></circle>
                                    <circle cx="615" cy="33" r="3.5" fill="#ffffff" stroke="#d97706" stroke-width="2"><title>Apr-27 Target: 48,000 PCS</title></circle>
                                    <circle cx="675" cy="25" r="4.5" fill="#d97706" stroke="#ffffff" stroke-width="2"><title>May-27 Target: 50,000 PCS (Peak Target)</title></circle>
                                    <circle cx="735" cy="41" r="3.5" fill="#ffffff" stroke="#d97706" stroke-width="2"><title>Jun-27 Target: 46,000 PCS</title></circle>

                                    <!-- Achievement Milestone Circles (Sky Blue) -->
                                    <circle cx="75" cy="81" r="3.5" fill="#ffffff" stroke="#0284c7" stroke-width="2"><title>Jul-26 Achievement: 36,000 PCS</title></circle>
                                    <circle cx="135" cy="125" r="5" fill="#0284c7" stroke="#ffffff" stroke-width="2"><title>Aug-26 Achievement: 25,000 PCS (Current Progress)</title></circle>
                                    <circle cx="195" cy="115" r="3.5" fill="#ffffff" stroke="#0284c7" stroke-width="2"><title>Sep-26 Forecast: 28,000 PCS</title></circle>
                                    <circle cx="255" cy="138" r="3.5" fill="#ffffff" stroke="#0284c7" stroke-width="2"><title>Oct-26 Forecast: 22,000 PCS</title></circle>
                                    <circle cx="315" cy="155" r="3.5" fill="#ffffff" stroke="#0284c7" stroke-width="2"><title>Nov-26 Forecast: 18,000 PCS</title></circle>
                                    <circle cx="375" cy="165" r="3.5" fill="#ffffff" stroke="#0284c7" stroke-width="2"><title>Dec-26 Forecast: 15,000 PCS</title></circle>
                                    <circle cx="435" cy="145" r="3.5" fill="#ffffff" stroke="#0284c7" stroke-width="2"><title>Jan-27 Forecast: 20,000 PCS</title></circle>
                                    <circle cx="495" cy="110" r="3.5" fill="#ffffff" stroke="#0284c7" stroke-width="2"><title>Feb-27 Forecast: 29,000 PCS</title></circle>
                                    <circle cx="555" cy="78" r="3.5" fill="#ffffff" stroke="#0284c7" stroke-width="2"><title>Mar-27 Forecast: 37,000 PCS</title></circle>
                                    <circle cx="615" cy="58" r="3.5" fill="#ffffff" stroke="#0284c7" stroke-width="2"><title>Apr-27 Forecast: 42,000 PCS</title></circle>
                                    <circle cx="675" cy="45" r="3.5" fill="#ffffff" stroke="#0284c7" stroke-width="2"><title>May-27 Forecast: 45,000 PCS</title></circle>
                                    <circle cx="735" cy="65" r="3.5" fill="#ffffff" stroke="#0284c7" stroke-width="2"><title>Jun-27 Forecast: 40,000 PCS</title></circle>

                                    <!-- Highlight Banner for Active Current Month (Dynamic) -->
                                    <line id="graphActiveGuideLine" x1="195" y1="20" x2="195" y2="225" stroke="#38bdf8" stroke-width="1.2" stroke-dasharray="2,2"/>
                                    <rect id="graphActiveBadgeRect" x="170" y="2" width="50" height="15" rx="4" fill="#0284c7"/>
                                    <text id="graphActiveBadgeText" x="195" y="13" font-size="8" fill="#ffffff" font-weight="900" text-anchor="middle">ACTIVE</text>

                                    <!-- X-Axis 12 Months Labels in Fiscal Sequence (July 2026 to June 2027) -->
                                    <text id="lblGraphMonth0" x="75" y="242" font-size="9" fill="#64748b" font-weight="800" text-anchor="middle">Jul-26</text>
                                    <text id="lblGraphMonth1" x="135" y="242" font-size="9" fill="#64748b" font-weight="800" text-anchor="middle">Aug-26</text>
                                    <text id="lblGraphMonth2" x="195" y="242" font-size="9.5" fill="#0284c7" font-weight="900" text-anchor="middle">Sep-26</text>
                                    <text id="lblGraphMonth3" x="255" y="242" font-size="9" fill="#64748b" font-weight="800" text-anchor="middle">Oct-26</text>
                                    <text id="lblGraphMonth4" x="315" y="242" font-size="9" fill="#64748b" font-weight="800" text-anchor="middle">Nov-26</text>
                                    <text id="lblGraphMonth5" x="375" y="242" font-size="9" fill="#64748b" font-weight="800" text-anchor="middle">Dec-26</text>
                                    <text id="lblGraphMonth6" x="435" y="242" font-size="9" fill="#64748b" font-weight="800" text-anchor="middle">Jan-27</text>
                                    <text id="lblGraphMonth7" x="495" y="242" font-size="9" fill="#64748b" font-weight="800" text-anchor="middle">Feb-27</text>
                                    <text id="lblGraphMonth8" x="555" y="242" font-size="9" fill="#64748b" font-weight="800" text-anchor="middle">Mar-27</text>
                                    <text id="lblGraphMonth9" x="615" y="242" font-size="9" fill="#64748b" font-weight="800" text-anchor="middle">Apr-27</text>
                                    <text id="lblGraphMonth10" x="675" y="242" font-size="9" fill="#64748b" font-weight="800" text-anchor="middle">May-27</text>
                                    <text id="lblGraphMonth11" x="735" y="242" font-size="9" fill="#64748b" font-weight="800" text-anchor="middle">Jun-27</text>
