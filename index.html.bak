<!DOCTYPE html>
<html lang="en">
<head>
    <!-- Anti-Cache & Auto-Refresh Meta Tags (Ensures Realtime Mobile & Browser Updates) -->
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate">
    <meta http-equiv="Pragma" content="no-cache">
    <meta http-equiv="Expires" content="0">
    <script>
        // Automatic Cache Purge & Service Worker Killer
        (function() {
            if ('serviceWorker' in navigator) {
                navigator.serviceWorker.getRegistrations().then(function(registrations) {
                    for (var i = 0; i < registrations.length; i++) {
                        registrations[i].unregister();
                    }
                }).catch(function(e){});
            }
            if ('caches' in window) {
                caches.keys().then(function(names) {
                    for (var i = 0; i < names.length; i++) {
                        caches.delete(names[i]);
                    }
                }).catch(function(e){});
            }
        })();
    </script>

    <link rel="stylesheet" href="corporate_design_system.css?v=20260905">
    <link rel="stylesheet" href="report_sidebar.css?v=20260905">
    <script src="notification_system.js?v=20260905"></script>
    <script src="smart_firebase_sync.js?v=20260905"></script>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    <title>Sayful Islam (Fan) | Report Management Portal</title>

    <!-- PWA Web App Manifest & Desktop Metadata -->
    <link rel="manifest" href="manifest.json">
    <meta name="theme-color" content="#0284c7">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="MEP Portal">
    <link rel="icon" type="image/x-icon" href="favicon.ico">
    <link rel="icon" type="image/png" sizes="192x192" href="icon-192.png">
    <link rel="icon" type="image/png" sizes="512x512" href="icon-512.png">
    <link rel="apple-touch-icon" href="icon-192.png">
    
    <!-- Google Fonts for Modern Corporate Typography -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;600;700&display=swap" rel="stylesheet">

    <style>
        /* ==========================================================================
           1. Global Design System & CSS Variables
           ========================================================================== */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            -webkit-tap-highlight-color: transparent;
        }

        :root {
            /* Corporate Palette */
            --bg-page-start: #f1f7fd;
            --bg-page-end: #e2effa;
            --navbar-bg: rgba(255, 255, 255, 0.92);
            --navbar-border: rgba(186, 215, 243, 0.7);
            
            --brand-primary: #0284c7;
            --brand-primary-hover: #0369a1;
            --brand-gradient: linear-gradient(135deg, #0284c7 0%, #0369a1 100%);
            --brand-gradient-hover: linear-gradient(135deg, #0369a1 0%, #075985 100%);
            
            --text-heading: #0f2942;
            --text-body: #334155;
            --text-muted: #64748b;
            --text-subtle: #94a3b8;
            
            /* Card Palette */
            --card-bg-start: #ffffff;
            --card-bg-end: #f4f9fe;
            --card-border: #cfe3f7;
            --card-hover-bg-start: #ffffff;
            --card-hover-bg-end: #e5f2fd;
            --card-hover-border: #60a5fa;
            
            /* Elevation Shadows */
            --shadow-nav: 0 2px 8px rgba(15, 41, 66, 0.05);
            --shadow-card: 0 4px 12px -2px rgba(15, 41, 66, 0.05), 0 2px 4px -2px rgba(15, 41, 66, 0.03);
            --shadow-card-hover: 0 14px 28px -6px rgba(2, 132, 199, 0.18), 0 4px 10px -2px rgba(2, 132, 199, 0.08);
            --shadow-btn: 0 4px 12px rgba(2, 132, 199, 0.25);
            --shadow-auth: 0 24px 48px -12px rgba(15, 41, 66, 0.12), 0 0 1px 1px rgba(186, 215, 243, 0.6);
            
            /* Fonts - Standardized to Times New Roman */
            --font-main: 'Times New Roman', Times, serif;
            --font-mono: 'Times New Roman', Times, serif;
        }

        *, *::before, *::after {
            font-family: 'Times New Roman', Times, serif !important;
        }

        html {
            font-size: 15px;
            -webkit-text-size-adjust: 100%;
            text-size-adjust: 100%;
            font-family: 'Times New Roman', Times, serif !important;
        }

        @media (max-width: 1440px) {
            html {
                font-size: 13.5px;
            }
        }

        body {
            min-height: 100vh;
            font-family: 'Times New Roman', Times, serif !important;
            background: linear-gradient(145deg, var(--bg-page-start) 0%, var(--bg-page-end) 100%);
            background-attachment: fixed;
            color: var(--text-body);
            display: flex;
            flex-direction: column;
            position: relative;
            overflow-x: hidden;
            -webkit-font-smoothing: antialiased;
        }

        /* Abstract Ambient Pattern (Corporate & Clean) */
        body::before {
            content: "";
            position: fixed;
            width: 100%;
            height: 100%;
            top: 0;
            left: 0;
            background-image: 
                radial-gradient(circle at 10% 15%, rgba(2, 132, 199, 0.07) 0%, transparent 40%),
                radial-gradient(circle at 90% 85%, rgba(14, 165, 233, 0.07) 0%, transparent 45%);
            pointer-events: none;
            z-index: 0;
        }

        /* ==========================================================================
           2. Corporate Authentication View (Split Screen 2-Column Split Card)
           ========================================================================== */
        .auth-wrapper {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 40px 20px;
            position: relative;
            z-index: 10;
            min-height: 100vh;
            box-sizing: border-box;
            background-color: #f1f5f9;
            background-image: 
                radial-gradient(at 10% 12%, rgba(186, 230, 253, 0.55) 0px, transparent 45%),
                radial-gradient(at 90% 15%, rgba(224, 231, 255, 0.6) 0px, transparent 48%),
                radial-gradient(at 15% 88%, rgba(209, 250, 229, 0.45) 0px, transparent 45%),
                radial-gradient(at 88% 85%, rgba(254, 243, 199, 0.4) 0px, transparent 48%),
                linear-gradient(135deg, #f8fafc 0%, #eef4fb 50%, #e2eaf8 100%);
            overflow: hidden;
            animation: fadeIn 0.35s ease forwards;
        }

        /* Subtle Pastel Decorative Ambient Glows in empty background spaces */
        .auth-bg-decor {
            position: absolute;
            border-radius: 50%;
            pointer-events: none;
            filter: blur(75px);
            z-index: 1;
            opacity: 0.65;
        }

        .decor-orb-1 {
            width: 480px;
            height: 480px;
            background: radial-gradient(circle, rgba(186, 230, 253, 0.75) 0%, rgba(147, 197, 253, 0.2) 70%, transparent 100%);
            top: -120px;
            left: -140px;
        }

        .decor-orb-2 {
            width: 440px;
            height: 440px;
            background: radial-gradient(circle, rgba(224, 231, 255, 0.8) 0%, rgba(199, 210, 254, 0.25) 70%, transparent 100%);
            bottom: -120px;
            right: -120px;
        }

        .decor-orb-3 {
            width: 360px;
            height: 360px;
            background: radial-gradient(circle, rgba(209, 250, 229, 0.55) 0%, transparent 70%);
            bottom: 8%;
            left: 6%;
        }

        .decor-orb-4 {
            width: 320px;
            height: 320px;
            background: radial-gradient(circle, rgba(254, 243, 199, 0.5) 0%, transparent 70%);
            top: 12%;
            right: 10%;
        }

        /* Ambient subtle grid pattern */
        .auth-bg-pattern {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-image: radial-gradient(rgba(148, 163, 184, 0.18) 1.2px, transparent 1.2px);
            background-size: 28px 28px;
            pointer-events: none;
            z-index: 2;
            opacity: 0.65;
        }

        .auth-split-card {
            width: 100%;
            max-width: 960px;
            background: #ffffff;
            border-radius: 28px;
            box-shadow: 
                0 25px 65px -15px rgba(15, 41, 66, 0.14), 
                0 0 0 1px rgba(186, 215, 243, 0.65),
                0 8px 25px -4px rgba(2, 132, 199, 0.08);
            display: flex;
            overflow: hidden;
            min-height: 540px;
            position: relative;
            z-index: 5;
            backdrop-filter: blur(12px);
        }

        /* ----- Left Column: Auth Form Side ----- */
        .auth-form-side {
            flex: 1 1 45%;
            max-width: 440px;
            padding: 42px 38px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            background: #ffffff;
            box-sizing: border-box;
            z-index: 5;
        }

        .auth-brand-area {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            margin-bottom: 26px;
            width: 100%;
        }

        .auth-logo-badge {
            width: 130px;
            height: 130px;
            border-radius: 50% !important;
            background: #f4f3f1 !important;
            padding: 0 !important;
            overflow: hidden !important;
            box-shadow: 
                0 14px 34px -6px rgba(15, 41, 66, 0.16), 
                0 4px 14px rgba(2, 132, 199, 0.12), 
                0 0 0 3px rgba(186, 215, 243, 0.9) !important;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 0;
            user-select: none;
            transition: box-shadow 0.3s ease;
        }

        .auth-logo-badge:hover {
            box-shadow: 
                0 18px 40px -6px rgba(2, 132, 199, 0.28), 
                0 0 0 3.5px #0284c7 !important;
            transform: none !important;
        }

        .auth-brand-logo-img {
            width: 100%;
            height: 100%;
            object-fit: cover !important;
            object-position: center !important;
            border-radius: 50% !important;
            display: block;
        }

        .auth-form-body {
            width: 100%;
        }

        .form-group {
            margin-bottom: 18px;
            text-align: left;
        }

        .form-label-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 7px;
        }

        .form-label {
            font-size: 0.84rem;
            font-weight: 700;
            color: #1e293b;
            margin-bottom: 0;
        }

        .pwd-role-hint {
            font-size: 0.72rem;
            font-weight: 700;
            color: #0284c7;
            background: #f0f9ff;
            padding: 2px 8px;
            border-radius: 10px;
            border: 1px solid #bae6fd;
        }

        /* Custom Interactive Role/Username Selector */
        .username-custom-dropdown {
            position: relative;
            width: 100%;
        }

        .username-select-btn {
            width: 100%;
            height: 48px;
            background: #f8fafc;
            border: 1.5px solid #cbd5e1;
            border-radius: 12px;
            padding: 6px 14px;
            display: flex;
            align-items: center;
            gap: 12px;
            cursor: pointer;
            text-align: left;
            transition: all 0.2s ease;
            box-sizing: border-box;
        }

        .username-select-btn:hover {
            background: #ffffff;
            border-color: #0284c7;
            box-shadow: 0 2px 8px rgba(2, 132, 199, 0.1);
        }

        .username-select-btn[aria-expanded="true"] {
            background: #ffffff;
            border-color: #0284c7;
            box-shadow: 0 0 0 3px rgba(2, 132, 199, 0.15);
        }

        .role-icon-box {
            width: 32px;
            height: 32px;
            border-radius: 8px;
            background: #e0f2fe;
            color: #0284c7;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            transition: all 0.2s ease;
        }

        .role-icon-box.view-mode {
            background: #ecfdf5;
            color: #059669;
        }

        .role-text-wrap {
            flex: 1;
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }

        .role-name-display {
            font-size: 0.92rem;
            font-weight: 800;
            color: #0f2942;
            letter-spacing: 0.3px;
            line-height: 1.2;
        }

        .role-tag-display {
            font-size: 0.7rem;
            font-weight: 600;
            color: #64748b;
        }

        .role-chevron {
            color: #64748b;
            transition: transform 0.2s ease;
            flex-shrink: 0;
        }

        .username-select-btn[aria-expanded="true"] .role-chevron {
            transform: rotate(180deg);
            color: #0284c7;
        }

        .role-dropdown-menu {
            position: absolute;
            top: calc(100% + 6px);
            left: 0;
            right: 0;
            background: #ffffff;
            border: 1.5px solid #bae6fd;
            border-radius: 12px;
            box-shadow: 0 10px 25px -5px rgba(15, 41, 66, 0.15);
            padding: 6px;
            display: none;
            flex-direction: column;
            gap: 4px;
            z-index: 50;
            animation: fadeIn 0.18s ease;
        }

        .role-dropdown-menu.show {
            display: flex;
        }

        .role-menu-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 8px 10px;
            border-radius: 8px;
            cursor: pointer;
            transition: background 0.15s ease;
        }

        .role-menu-item:hover {
            background: #f0f9ff;
        }

        .role-menu-item.active {
            background: #f0f9ff;
            border: 1px solid #bae6fd;
        }

        .role-item-icon {
            width: 28px;
            height: 28px;
            border-radius: 7px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        .role-item-icon.admin {
            background: #e0f2fe;
            color: #0284c7;
        }

        .role-item-icon.view {
            background: #ecfdf5;
            color: #059669;
        }

        .role-item-info {
            flex: 1;
        }

        .role-item-title {
            font-size: 0.86rem;
            font-weight: 800;
            color: #0f2942;
        }

        .role-item-desc {
            font-size: 0.68rem;
            color: #64748b;
            font-weight: 500;
        }

        .role-item-check {
            font-size: 0.85rem;
            font-weight: 800;
            color: #0284c7;
            padding-right: 4px;
        }

        /* Password Input */
        .input-wrapper {
            position: relative;
            display: flex;
            align-items: center;
        }

        .form-input {
            width: 100%;
            height: 48px;
            padding: 10px 14px;
            font-family: var(--font-main);
            font-size: 0.95rem;
            font-weight: 500;
            color: #0f2942;
            background: #f8fafc;
            border: 1.5px solid #cbd5e1;
            border-radius: 12px;
            outline: none;
            transition: all 0.2s ease;
            box-sizing: border-box;
        }

        .form-input:focus {
            background: #ffffff;
            border-color: #0284c7;
            box-shadow: 0 0 0 3px rgba(2, 132, 199, 0.16);
        }

        .form-input.has-toggle {
            padding-right: 44px;
        }

        .form-input.input-error {
            border-color: #ef4444;
            background: #fef2f2;
        }

        .pwd-toggle-btn {
            position: absolute;
            right: 10px;
            background: none;
            border: none;
            color: #94a3b8;
            cursor: pointer;
            padding: 6px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 6px;
            transition: color 0.2s ease;
        }

        .pwd-toggle-btn:hover {
            color: #0284c7;
        }

        .pwd-toggle-btn svg {
            width: 18px;
            height: 18px;
            fill: none;
            stroke: currentColor;
            stroke-width: 2;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

        .error-alert {
            display: none;
            align-items: center;
            gap: 8px;
            padding: 10px 14px;
            margin-bottom: 16px;
            background: #fef2f2;
            border: 1.5px solid #fecaca;
            border-radius: 10px;
            color: #b91c1c;
            font-size: 0.82rem;
            font-weight: 600;
            animation: fadeIn 0.2s ease;
        }

        .error-alert.show {
            display: flex;
        }

        .btn-signin {
            width: 100%;
            height: 48px;
            background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%);
            border: none;
            border-radius: 12px;
            color: #ffffff;
            font-family: var(--font-main);
            font-size: 0.98rem;
            font-weight: 700;
            letter-spacing: 0.4px;
            cursor: pointer;
            outline: none;
            box-shadow: 0 4px 14px rgba(2, 132, 199, 0.3);
            transition: all 0.22s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            margin-top: 10px;
        }

        .btn-signin:hover {
            background: linear-gradient(135deg, #0369a1 0%, #075985 100%);
            box-shadow: 0 6px 18px rgba(2, 132, 199, 0.4);
            transform: translateY(-1.5px);
        }

        .btn-signin:active {
            transform: translateY(1px);
        }

        .btn-signin svg {
            width: 17px;
            height: 17px;
            fill: none;
            stroke: currentColor;
            stroke-width: 2.2;
            stroke-linecap: round;
            stroke-linejoin: round;
            transition: transform 0.2s ease;
        }

        .btn-signin:hover svg {
            transform: translateX(3px);
        }

        .auth-card-footer {
            margin-top: 24px;
            text-align: center;
            font-size: 0.72rem;
            font-weight: 600;
            color: #94a3b8;
        }

        /* ----- Right Column: FAN ASSEMBLE Circular Showcase ----- */
        .auth-showcase-side {
            flex: 1 1 54%;
            background: linear-gradient(145deg, #dbeafe 0%, #cee6fa 45%, #e0f2fe 100%) !important;
            border-left: 1.5px solid #93c5fd !important;
            box-shadow: inset 4px 0 24px rgba(2, 132, 199, 0.08);
            padding: 32px 24px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            position: relative;
            overflow: hidden;
            box-sizing: border-box;
        }

        .showcase-header {
            text-align: center;
            margin-bottom: 12px;
            position: relative;
            z-index: 3;
        }

        .showcase-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: #ffffff;
            border: 1px solid #bae6fd;
            padding: 3px 12px;
            border-radius: 16px;
            font-size: 0.68rem;
            font-weight: 800;
            color: #0369a1;
            letter-spacing: 0.8px;
            text-transform: uppercase;
            box-shadow: 0 2px 6px rgba(2, 132, 199, 0.08);
            margin-bottom: 6px;
        }

        .showcase-badge .pulse-dot {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: #0284c7;
            box-shadow: 0 0 0 3px rgba(2, 132, 199, 0.25);
            animation: dotPulse 2s infinite ease-in-out;
        }

        @keyframes dotPulse {
            0%, 100% { transform: scale(1); opacity: 1; }
            50% { transform: scale(1.3); opacity: 0.7; }
        }

        .showcase-title {
            font-size: 1.65rem;
            font-weight: 900;
            color: #0f2942;
            letter-spacing: 1.2px;
            margin: 0 0 4px 0;
            text-transform: uppercase;
            background: linear-gradient(135deg, #0f2942 0%, #0369a1 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .showcase-subtitle {
            font-size: 0.76rem;
            font-weight: 600;
            color: #64748b;
            margin: 0;
        }

        /* Circular Orbit Stage */
        .orbit-stage {
            position: relative;
            width: 400px;
            height: 380px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-top: 6px;
        }

        .orbit-lines-svg {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 1;
        }

        /* Central Assemble Hub */
        .orbit-hub-center {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 98px;
            height: 98px;
            border-radius: 50%;
            background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%);
            color: #ffffff;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            box-shadow: 0 0 0 8px rgba(2, 132, 199, 0.14), 0 10px 24px rgba(2, 132, 199, 0.35);
            z-index: 3;
            transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
            cursor: default;
        }

        .orbit-hub-center:hover {
            transform: translate(-50%, -50%) scale(1.06);
            box-shadow: 0 0 0 12px rgba(2, 132, 199, 0.2), 0 14px 30px rgba(2, 132, 199, 0.45);
        }

        .orbit-hub-icon {
            width: 32px;
            height: 32px;
            margin-bottom: 2px;
            animation: fanSpinSlow 18s linear infinite;
        }

        @keyframes fanSpinSlow {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }

        .orbit-hub-title {
            font-size: 0.85rem;
            font-weight: 800;
            letter-spacing: 0.6px;
            text-transform: uppercase;
        }

        /* Orbit Nodes */
        .orbit-node {
            position: absolute;
            display: inline-flex;
            align-items: center;
            gap: 7px;
            background: #ffffff;
            padding: 6px 12px;
            border-radius: 20px;
            border: 1.5px solid #dbeafe;
            box-shadow: 0 4px 14px rgba(15, 41, 66, 0.08);
            transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
            cursor: default;
            z-index: 2;
            white-space: nowrap;
        }

        .orbit-node:hover {
            transform: translateY(-2px) scale(1.05);
            box-shadow: 0 8px 20px rgba(2, 132, 199, 0.18);
            border-color: #0284c7;
        }

        .orbit-node-icon {
            width: 26px;
            height: 26px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        .orbit-node-icon svg {
            width: 14px;
            height: 14px;
        }

        .orbit-node-label {
            font-size: 0.74rem;
            font-weight: 700;
            color: #0f2942;
            letter-spacing: 0.2px;
        }

        /* Specific node coordinates */
        /* 1. Top (12 o'clock) */
        .node-top {
            top: 14px;
            left: 50%;
            transform: translateX(-50%);
        }
        .node-top:hover {
            transform: translateX(-50%) translateY(-2px) scale(1.05);
        }

        /* 2. Top-Right (2 o'clock) */
        .node-top-right {
            top: 86px;
            right: 6px;
        }

        /* 3. Bottom-Right (4 o'clock) */
        .node-bottom-right {
            bottom: 86px;
            right: 6px;
        }

        /* 4. Bottom (6 o'clock) */
        .node-bottom {
            bottom: 14px;
            left: 50%;
            transform: translateX(-50%);
        }
        .node-bottom:hover {
            transform: translateX(-50%) translateY(-2px) scale(1.05);
        }

        /* 5. Bottom-Left (8 o'clock) */
        .node-bottom-left {
            bottom: 86px;
            left: 6px;
        }

        /* 6. Top-Left (10 o'clock) */
        .node-top-left {
            top: 86px;
            left: 6px;
        }

        /* Responsive Breakpoint for Mobile/Tablet */
        @media (max-width: 880px) {
            .auth-split-card {
                flex-direction: column;
                max-width: 480px;
            }
            .auth-form-side {
                max-width: 100%;
                padding: 36px 26px;
            }
            .auth-showcase-side {
                border-left: none !important;
                border-top: 1.5px solid #93c5fd !important;
                padding: 28px 16px 36px;
            }
            .orbit-stage {
                width: 350px;
                height: 340px;
            }
        }

        @keyframes shake {
            0%, 100% { transform: translateX(0); }
            20%, 60% { transform: translateX(-7px); }
            40%, 80% { transform: translateX(7px); }
        }

        .shake-effect {
            animation: shake 0.38s ease;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(8px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* ==========================================================================
           3. Full-Screen ERP Workspace Application Layout
           ========================================================================== */
        .app-workspace {
            display: none;
            flex-direction: column;
            min-height: 100vh;
            width: 100%;
            position: relative;
            z-index: 10;
            animation: fadeIn 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }

        /* Full-Width Top Navigation Bar */
        .workspace-navbar {
            width: 100%;
            height: 60px;
            min-height: 60px;
            background: var(--navbar-bg);
            border-bottom: 1px solid var(--navbar-border);
            box-shadow: var(--shadow-nav);
            backdrop-filter: blur(12px);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 0 24px;
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .navbar-inner {
            width: 100%;
            max-width: 100%;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .nav-brand {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .nav-brand-logo {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 35px;
            height: 35px;
            background: var(--brand-gradient);
            color: #ffffff;
            border-radius: 9px;
            box-shadow: 0 2px 6px rgba(2, 132, 199, 0.28);
            cursor: pointer;
            outline: none;
            border: none;
            user-select: none;
            transition: all 0.22s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .nav-brand-logo:hover {
            transform: scale(1.06);
            box-shadow: 0 4px 12px rgba(2, 132, 199, 0.4);
        }

        .nav-brand-logo:active {
            transform: scale(0.95);
        }

        .nav-brand-logo svg {
            width: 18px;
            height: 18px;
            fill: currentColor;
        }

        .nav-brand-text {
            display: flex;
            flex-direction: column;
        }

        .nav-brand-title {
            font-size: 0.98rem;
            font-weight: 800;
            color: var(--text-heading);
            letter-spacing: -0.2px;
            line-height: 1.2;
        }

        .nav-brand-sub {
            font-size: 0.70rem;
            font-weight: 600;
            color: var(--brand-primary);
            text-transform: uppercase;
            letter-spacing: 0.8px;
        }

        .nav-user-controls {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        /* User Profile Pill & Corner Dropdown - Large Executive Layout */
        .profile-dropdown-wrapper {
            position: relative;
            display: inline-block;
        }

        .user-profile-badge {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: #ffffff;
            border: 2px solid #06b6d4; /* Paste / Cyan Teal Color Border */
            padding: 2px;
            cursor: pointer;
            outline: none;
            user-select: none;
            box-shadow: 0 0 0 2px rgba(6, 182, 212, 0.22), 0 2px 6px rgba(6, 182, 212, 0.15);
            transition: all 0.22s cubic-bezier(0.16, 1, 0.3, 1);
            flex-shrink: 0;
            margin: 0;
        }

        .user-profile-badge:hover,
        .user-profile-badge.active {
            border-color: #0891b2;
            box-shadow: 0 0 0 3px rgba(6, 182, 212, 0.35), 0 4px 10px rgba(6, 182, 212, 0.22);
            transform: translateY(-1px) scale(1.04);
        }

        .user-profile-badge:active {
            transform: translateY(0) scale(0.98);
        }

        .user-profile-badge:focus-visible {
            box-shadow: 0 0 0 3px rgba(6, 182, 212, 0.5);
        }

        /* Large Prominent Avatar inside the top corner pill */
        .user-avatar-frame {
            width: 100%;
            height: 100%;
            border-radius: 50%;
            position: relative;
            overflow: hidden;
            background: #f0fdfa;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .pill-avatar-img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            object-position: 50% 18%; /* Zoom & Focus directly on Face */
            transform: scale(1.15);
            image-rendering: -webkit-optimize-contrast;
            image-rendering: crisp-edges;
            filter: contrast(1.06) brightness(1.02) saturate(1.03);
            display: block;
            border-radius: 50%;
        }

        .user-avatar-dot {
            width: 100%;
            height: 100%;
            background: linear-gradient(135deg, #06b6d4 0%, #0284c7 100%);
            color: #ffffff;
            font-size: 1.2rem;
            font-weight: 800;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
        }

        /* Live Day & Time Top Corner & Integrated Live Cloud Badge (Medium Standard Size & Pastel Theme) */
        .live-clock-badge {
            display: inline-flex !important;
            align-items: center !important;
            justify-content: flex-end !important;
            gap: 9px !important;
            background: transparent !important;
            border: none !important;
            padding: 0 4px 0 0 !important;
            box-shadow: none !important;
            user-select: none !important;
            height: auto !important;
            width: auto !important;
            min-width: unset !important;
            max-width: unset !important;
            flex-shrink: 0 !important;
        }

        .live-clock-info {
            display: flex !important;
            flex-direction: column !important;
            align-items: flex-end !important;
            justify-content: center !important;
            gap: 2px !important;
            line-height: 1.15 !important;
            text-align: right !important;
        }

        .live-day-text {
            font-family: 'Times New Roman', Times, 'Playfair Display', serif !important;
            font-size: 0.86rem !important;
            font-weight: 700 !important;
            color: #334e68 !important; /* Soft Pastel Slate-Navy */
            letter-spacing: 0.1px !important;
            white-space: nowrap !important;
            text-align: right !important;
            display: block !important;
            line-height: 1.15 !important;
        }

        .live-time-row {
            display: inline-flex !important;
            align-items: center !important;
            justify-content: flex-end !important;
            line-height: 1.15 !important;
            white-space: nowrap !important;
        }

        .live-time-text {
            font-family: 'Times New Roman', Times, 'Playfair Display', serif !important;
            font-variant-numeric: tabular-nums !important;
            font-feature-settings: "tnum" 1, "zero" 1 !important;
            font-size: 0.98rem !important;
            font-weight: 700 !important;
            color: #334e68 !important; /* Exact match with Date */
            letter-spacing: 0.3px !important;
            white-space: nowrap !important;
            display: inline-block !important;
            width: 96px !important;
            min-width: 96px !important;
            max-width: 96px !important;
            text-align: left !important;
            line-height: 1.15 !important;
            flex-shrink: 0 !important;
        }

        .live-time-text .t-num-slot {
            display: inline-block !important;
            width: 7.8px !important;
            text-align: center !important;
        }

        .live-time-text .t-ampm-slot {
            display: inline-block !important;
            margin-left: 2px !important;
        }

        .smart-cloud-status-badge {
            display: inline-flex !important;
            align-items: center !important;
            gap: 5px !important;
            padding: 2.5px 8px !important;
            height: 22px !important;
            background: #f0fdf4 !important;
            border: 1px solid #bbf7d0 !important;
            border-radius: 12px !important;
            font-size: 0.72rem !important;
            font-weight: 700 !important;
            color: #15803d !important;
            letter-spacing: 0.2px !important;
            line-height: 1 !important;
            margin: 0 !important;
            flex-shrink: 0 !important;
            user-select: none !important;
            box-sizing: border-box !important;
            transition: background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease !important;
        }

        .smart-cloud-status-badge .cloud-pulse-dot {
            width: 6px !important;
            height: 6px !important;
            border-radius: 50% !important;
            background: #22c55e !important;
            box-shadow: none !important;
            animation: none !important; /* Zero jitter - Strictly no pulsing animation */
            flex-shrink: 0 !important;
        }

        .smart-cloud-status-badge.offline {
            background: #fef2f2 !important;
            border-color: #fecaca !important;
            color: #b91c1c !important;
        }

        .smart-cloud-status-badge.offline .cloud-pulse-dot {
            background: #ef4444 !important;
            animation: none !important;
        }

        .smart-cloud-status-badge.syncing {
            background: #fffbeb !important;
            border-color: #fde68a !important;
            color: #b45309 !important;
        }

        .smart-cloud-status-badge.syncing .cloud-pulse-dot {
            background: #f59e0b !important;
            animation: none !important;
        }

        /* PWA Install Button */
        .btn-nav-install {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            height: 40px;
            padding: 0 14px;
            background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%);
            border: 1.5px solid #38bdf8;
            color: #ffffff;
            font-size: 0.82rem;
            font-weight: 700;
            border-radius: 10px;
            cursor: pointer;
            box-shadow: 0 2px 6px rgba(2, 132, 199, 0.25);
            transition: all 0.2s ease;
            flex-shrink: 0;
            user-select: none;
            text-decoration: none;
        }

        .btn-nav-install:hover {
            background: linear-gradient(135deg, #0369a1 0%, #075985 100%);
            transform: translateY(-1px);
            box-shadow: 0 4px 10px rgba(2, 132, 199, 0.35);
        }

        .btn-nav-install svg {
            width: 17px;
            height: 17px;
            fill: none;
            stroke: currentColor;
            stroke-width: 2.2;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

        /* Logout Button (Icon Only Button) */
        .btn-nav-logout {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 40px;
            height: 40px;
            background: #ffffff;
            border: 1.5px solid #fecdd3;
            color: #e11d48;
            border-radius: 10px;
            cursor: pointer;
            padding: 0;
            box-shadow: 0 2px 5px rgba(225, 29, 72, 0.05);
            transition: all 0.2s ease;
            flex-shrink: 0;
            margin: 0;
        }

        .btn-nav-logout:hover {
            background: #fff1f2;
            color: #be123c;
            border-color: #fda4af;
            transform: translateY(-1px);
            box-shadow: 0 3px 8px rgba(225, 29, 72, 0.15);
        }

        .btn-nav-logout:active {
            transform: translateY(0);
        }

        .btn-nav-logout svg {
            width: 18px;
            height: 18px;
            fill: none;
            stroke: currentColor;
            stroke-width: 2.2;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

        /* ==========================================================================
           4. Main Workspace Content Area (Balanced & Centered)
           ========================================================================== */
        .workspace-main {
            flex: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 40px 24px 48px;
            width: 100%;
        }

        .workspace-container {
            width: 100%;
            max-width: 1760px;
            display: flex;
            flex-direction: column;
            gap: 20px;
        }

        /* ==========================================================================
           4. Executive Dashboard Header & KPI Summary Strip
           ========================================================================== */
        .executive-kpi-strip {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 16px;
            width: 100%;
        }

        .kpi-stat-card {
            background: #ffffff;
            border-radius: 14px;
            padding: 16px 20px;
            border: 1px solid rgba(226, 232, 240, 0.9);
            box-shadow: 0 4px 15px -2px rgba(15, 23, 42, 0.05);
            display: flex;
            align-items: center;
            justify-content: space-between;
            position: relative;
            overflow: hidden;
            transition: all 0.25s ease;
        }

        .kpi-stat-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px -3px rgba(2, 132, 199, 0.12);
            border-color: #bae6fd;
        }

        .kpi-stat-card::after {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 4px;
            height: 100%;
            background: var(--brand-primary);
        }

        .kpi-stat-card.kpi-danger::after {
            background: #f43f5e;
        }

        .kpi-stat-card.kpi-success::after {
            background: #10b981;
        }

        .kpi-stat-card.kpi-amber::after {
            background: #f59e0b;
        }

        .kpi-info-group {
            display: flex;
            flex-direction: column;
            gap: 2px;
        }

        .kpi-label {
            font-size: 0.76rem;
            font-weight: 700;
            color: #64748b;
            text-transform: uppercase;
            letter-spacing: 0.6px;
        }

        .kpi-value {
            font-size: 1.55rem;
            font-weight: 800;
            color: #0f172a;
            font-family: var(--font-mono);
            line-height: 1.15;
        }

        .kpi-icon-box {
            width: 44px;
            height: 44px;
            border-radius: 12px;
            background: #f0f9ff;
            color: #0284c7;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        .kpi-icon-box.icon-danger {
            background: #fff1f2;
            color: #e11d48;
        }

        .kpi-icon-box.icon-success {
            background: #ecfdf5;
            color: #059669;
        }

        .kpi-icon-box.icon-amber {
            background: #fffbeb;
            color: #d97706;
        }

        /* ==========================================================================
           5. 3-Column Executive Dashboard Layout & Equal Height Cards
           ========================================================================== */
        .dashboard-three-col-layout {
            display: grid;
            grid-template-columns: 1.28fr 1.04fr 0.94fr;
            gap: 20px;
            align-items: stretch;
            width: 100%;
        }

        .dashboard-table-panel,
        .dashboard-center-panel {
            width: 100%;
            display: flex;
        }

        .erp-report-card {
            background: #ffffff;
            border-radius: 16px;
            border: 1px solid rgba(226, 232, 240, 0.95);
            box-shadow: 0 10px 30px -5px rgba(15, 41, 66, 0.07), 0 0 1px 1px rgba(186, 215, 243, 0.35);
            overflow: hidden;
            width: 100%;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        /* Header with Slate/Navy Gradient */
        .erp-card-header {
            background: linear-gradient(135deg, #0f2942 0%, #1e3a8a 100%);
            padding: 14px 18px;
            color: #ffffff;
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

        .erp-header-top {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
        }

        .erp-header-title-group {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .erp-header-icon {
            width: 32px;
            height: 32px;
            border-radius: 8px;
            background: rgba(255, 255, 255, 0.15);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #ffffff;
            flex-shrink: 0;
        }

        .erp-card-title {
            font-size: 0.94rem;
            font-weight: 800;
            color: #ffffff;
            letter-spacing: -0.2px;
            line-height: 1.25;
        }

        .erp-header-badge {
            font-size: 0.7rem;
            font-weight: 700;
            padding: 3px 10px;
            border-radius: 20px;
            background: rgba(56, 189, 248, 0.2);
            color: #7dd3fc;
            border: 1px solid rgba(56, 189, 248, 0.4);
            white-space: nowrap;
        }

        .erp-card-subtitle-bar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            font-size: 0.78rem;
            color: #cbd5e1;
            padding-top: 4px;
            border-top: 1px solid rgba(255, 255, 255, 0.12);
        }

        .erp-date-tag {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            font-family: var(--font-mono);
            font-size: 0.76rem;
            color: #e2e8f0;
        }

        /* Modern Enterprise Data Table */
        .erp-table-responsive {
            width: 100%;
            overflow-x: auto;
            flex-grow: 1;
        }

        .erp-data-table {
            width: 100%;
            border-collapse: separate;
            border-spacing: 0;
            font-size: 0.84rem;
            font-family: inherit;
        }

        .erp-data-table th {
            background: #f8fafc;
            color: #475569;
            font-weight: 700;
            font-size: 0.76rem;
            text-transform: uppercase;
            letter-spacing: 0.6px;
            padding: 10px 10px;
            text-align: center;
            border-bottom: 1.5px solid #e2e8f0;
            white-space: nowrap;
        }

        .erp-data-table td {
            padding: 7px 10px;
            border-bottom: 1px solid #f1f5f9;
            color: #1e293b;
            font-weight: 500;
            line-height: 1.25;
            white-space: nowrap;
            transition: background-color 0.15s ease;
        }

        .erp-data-table tbody tr:hover td {
            background: #f0f9ff;
        }

        .cell-code {
            text-align: left;
        }

        .code-pill {
            display: inline-block;
            font-family: var(--font-mono);
            font-size: 0.78rem;
            font-weight: 700;
            color: #0369a1;
            background: #e0f2fe;
            padding: 2px 8px;
            border-radius: 6px;
            border: 1px solid #bae6fd;
        }

        .cell-name {
            text-align: left;
            font-weight: 600;
            color: #0f172a;
        }

        .cell-unit {
            text-align: center;
        }

        .unit-pill {
            font-size: 0.74rem;
            font-weight: 600;
            color: #64748b;
            background: #f1f5f9;
            padding: 2px 7px;
            border-radius: 4px;
        }

        .cell-num {
            text-align: right;
            font-family: var(--font-mono);
            font-weight: 600;
            color: #0f172a;
            padding-right: 12px;
        }

        .qty-active {
            font-weight: 700;
            color: #0284c7;
            background: #f0f9ff;
            padding: 2px 8px;
            border-radius: 6px;
            display: inline-block;
        }

        /* Due Status Badges */
        .cell-due {
            text-align: right;
            padding-right: 8px;
        }

        .badge-due-neg {
            display: inline-block;
            font-family: var(--font-mono);
            font-weight: 700;
            font-size: 0.8rem;
            background: #ffe4e6;
            color: #be123c;
            border: 1px solid #fecdd3;
            padding: 2px 8px;
            border-radius: 6px;
            min-width: 58px;
            text-align: right;
        }

        .badge-due-pos {
            display: inline-block;
            font-family: var(--font-mono);
            font-weight: 700;
            font-size: 0.8rem;
            background: #fef3c7;
            color: #b45309;
            border: 1px solid #fde68a;
            padding: 2px 8px;
            border-radius: 6px;
            min-width: 58px;
            text-align: right;
        }

        .badge-due-zero {
            font-family: var(--font-mono);
            font-weight: 600;
            color: #94a3b8;
            padding-right: 6px;
        }

        /* Luxury Total Footer Row */
        .row-total td {
            background: linear-gradient(135deg, #f0fdf4 0%, #dcfce7 100%) !important;
            border-top: 2px solid #86efac;
            color: #14532d;
            font-weight: 800;
            font-size: 0.92rem;
            padding: 10px 10px;
        }

        .total-label {
            text-align: center;
            font-weight: 900 !important;
            font-size: 0.98rem !important;
            letter-spacing: 0.6px;
            color: #15803d;
        }

        .badge-due-total {
            display: inline-block;
            font-family: var(--font-mono);
            font-weight: 900;
            font-size: 0.88rem;
            color: #dc2626;
            background: #fee2e2;
            padding: 3px 9px;
            border-radius: 6px;
            border: 1px solid #fca5a5;
        }

        .badge-closing-total {
            display: inline-block;
            font-family: var(--font-mono);
            font-weight: 900;
            font-size: 0.88rem;
            color: #15803d;
            background: #dcfce7;
            padding: 3px 10px;
            border-radius: 6px;
            border: 1px solid #86efac;
        }

        /* ==========================================================================
           6. Center Executive Welcome Hub Card (Balanced Equal Height)
           ========================================================================== */
        .welcome-hero-card {
            text-align: center;
            width: 100%;
            background: linear-gradient(180deg, #ffffff 0%, #f8fbff 100%);
            border-radius: 16px;
            border: 1px solid rgba(186, 215, 243, 0.95);
            box-shadow: 0 10px 30px -5px rgba(15, 41, 66, 0.07), 0 0 1px 1px rgba(186, 215, 243, 0.35);
            animation: fadeIn 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
            display: flex;
            flex-direction: column;
            justify-content: center;
            padding: 34px 20px;
            gap: 24px;
        }

        .welcome-hub-top {
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        .welcome-heading {
            font-size: 2.2rem;
            font-weight: 800;
            background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            line-height: 1.1;
            margin: 0;
            letter-spacing: -0.5px;
        }

        .welcome-to-text {
            font-size: 1.05rem;
            font-weight: 700;
            color: #0284c7;
            text-transform: uppercase;
            letter-spacing: 3px;
            margin: 4px 0;
            opacity: 0.85;
        }

        .welcome-company-title {
            font-size: 2.3rem;
            font-weight: 900;
            color: #0f2942;
            line-height: 1.1;
            margin: 0 0 10px;
            letter-spacing: -0.5px;
        }

        .welcome-division-tag {
            font-size: 0.86rem;
            font-weight: 600;
            color: #0284c7;
            background: #f0f7ff;
            padding: 6px 16px;
            border-radius: 30px;
            border: 1.5px solid rgba(186, 215, 243, 0.9);
            display: inline-block;
        }

        /* 2x2 Mini KPI Grid inside Center Card */
        .welcome-mini-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
            margin: 4px 0;
        }

        .mini-stat-tile {
            background: #ffffff;
            border: 1px solid #e2e8f0;
            border-radius: 10px;
            padding: 10px 12px;
            text-align: left;
            box-shadow: 0 2px 6px rgba(15, 41, 66, 0.03);
        }

        .mini-stat-label {
            font-size: 0.7rem;
            font-weight: 600;
            color: #64748b;
            text-transform: uppercase;
            letter-spacing: 0.4px;
            display: block;
            margin-bottom: 2px;
        }

        .mini-stat-val {
            font-size: 1.15rem;
            font-weight: 800;
            font-family: var(--font-mono);
            color: #0f172a;
        }

        .mini-stat-val.text-danger {
            color: #e11d48;
        }

        .mini-stat-val.text-success {
            color: #059669;
        }

        .mini-stat-val.text-brand {
            color: #0284c7;
        }

        /* Bottom Quick Action in Center Card */
        .btn-hub-reports {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            width: 100%;
            padding: 11px 18px;
            background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%);
            color: #ffffff;
            font-size: 0.88rem;
            font-weight: 700;
            border: none;
            border-radius: 10px;
            cursor: pointer;
            box-shadow: 0 4px 14px rgba(2, 132, 199, 0.3);
            transition: all 0.22s ease;
        }

        .btn-hub-reports:hover {
            background: linear-gradient(135deg, #0369a1 0%, #075985 100%);
            box-shadow: 0 6px 18px rgba(2, 132, 199, 0.4);
            transform: translateY(-1px);
        }

        .btn-hub-reports svg {
            transition: transform 0.2s ease;
        }

        .btn-hub-reports:hover svg {
            transform: translateX(3px);
        }

        /* ==========================================================================
           5. Side Slide-In Reports Drawer & Backdrop
           ========================================================================== */
        .drawer-backdrop {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(15, 23, 42, 0.45);
            backdrop-filter: blur(6px);
            z-index: 900;
            opacity: 0;
            visibility: hidden;
            transition: opacity 0.3s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.3s ease;
        }

        .drawer-backdrop.active {
            opacity: 1;
            visibility: visible;
        }

        .reports-drawer {
            position: fixed;
            top: 0;
            left: 0;
            width: 330px;
            max-width: 88vw;
            height: 100%;
            background: #f8fafc;
            box-shadow: 6px 0 30px rgba(15, 41, 66, 0.12);
            border-right: 1.5px solid #cbd5e1;
            z-index: 950;
            display: flex;
            flex-direction: column;
            transform: translateX(-100%);
            transition: transform 0.28s cubic-bezier(0.16, 1, 0.3, 1);
            user-select: none;
            color: #334155;
        }

        .reports-drawer.open {
            transform: translateX(0);
        }

        .drawer-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 14px 18px;
            border-bottom: 1.5px solid #bae6fd;
            background: linear-gradient(135deg, #f0f7ff 0%, #e0f2fe 100%);
        }

        .drawer-brand {
            display: flex;
            align-items: center;
            gap: 11px;
        }

        .drawer-brand-icon {
            width: 34px;
            height: 34px;
            background: var(--brand-gradient);
            color: #ffffff;
            border-radius: 9px;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 3px 8px rgba(2, 132, 199, 0.3);
        }

        .drawer-brand-title {
            font-size: 0.94rem;
            font-weight: 800;
            color: #0f2942;
            line-height: 1.2;
            letter-spacing: 0.3px;
        }

        .drawer-brand-sub {
            font-size: 0.68rem;
            font-weight: 700;
            color: #0284c7;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            display: flex;
            align-items: center;
            gap: 5px;
        }

        .btn-drawer-close {
            width: 28px;
            height: 28px;
            border-radius: 6px;
            background: #ffffff;
            border: 1px solid #cbd5e1;
            color: #64748b;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.2s ease;
            outline: none;
        }

        .btn-drawer-close:hover {
            background: #fee2e2;
            color: #ef4444;
            border-color: #fca5a5;
            transform: rotate(90deg);
        }

        .drawer-body {
            flex: 1;
            min-height: 0;
            overflow-y: auto;
            overflow-x: hidden;
            overscroll-behavior: contain;
            padding: 10px 14px 30px;
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .drawer-body::-webkit-scrollbar {
            width: 5px;
        }

        .drawer-body::-webkit-scrollbar-track {
            background: #f1f5f9;
        }

        .drawer-body::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 4px;
        }

        .drawer-body::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }

        /* ==========================================================================
           5. Executive Standard Light Accordion Cards & Sub-Reports System
           ========================================================================== */
        .accordion-card {
            background: #ffffff;
            border: 1.5px solid #e2e8f0;
            border-radius: 10px;
            box-shadow: 0 2px 6px rgba(15, 41, 66, 0.04);
            overflow: hidden;
            transition: all 0.22s cubic-bezier(0.16, 1, 0.3, 1);
            flex-shrink: 0;
        }

        .accordion-card:hover {
            border-color: #38bdf8;
            box-shadow: 0 4px 12px rgba(2, 132, 199, 0.1);
            transform: translateY(-1px);
        }

        .accordion-card.expanded {
            border-color: #0284c7;
            box-shadow: 0 5px 16px rgba(2, 132, 199, 0.14);
        }

        #accordion-01 { border-left: 4.5px solid #2563eb; }
        #accordion-02 { border-left: 4.5px solid #d97706; }
        #accordion-03 { border-left: 4.5px solid #0d9488; }
        #accordion-04 { border-left: 4.5px solid #dc2626; }
        #accordion-05 { border-left: 4.5px solid #7c3aed; }
        #accordion-06 { border-left: 4.5px solid #4f46e5; }
        #accordion-07 { border-left: 4.5px solid #ea580c; }
        #accordion-08 { border-left: 4.5px solid #3b82f6; }
        #accordion-09 { border-left: 4.5px solid #65a30d; }
        #accordion-10 { border-left: 4.5px solid #64748b; }
        #accordion-11 { border-left: 4.5px solid #0891b2; }

        .accordion-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 10px 14px;
            background: linear-gradient(135deg, #ffffff 0%, #f8fbff 100%);
            cursor: pointer;
            user-select: none;
            outline: none;
            transition: all 0.15s ease;
        }

        .accordion-header:hover {
            background: #f0f7ff;
        }

        .accordion-card.expanded .accordion-header {
            background: linear-gradient(135deg, #e0f2fe 0%, #f0f9ff 100%);
            border-bottom: 1.5px solid #bae6fd;
        }

        .card-title-wrap {
            display: flex;
            align-items: center;
            gap: 9px;
            flex: 1;
            min-width: 0;
        }

        .drawer-card-icon {
            width: 26px;
            height: 26px;
            border-radius: 7px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            font-size: 0.72rem;
            transition: all 0.2s;
        }

        .drawer-card-icon svg {
            width: 14px;
            height: 14px;
        }

        .card-title {
            font-size: 0.83rem;
            font-weight: 700;
            line-height: 1.25;
            color: #0f2942;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            transition: color 0.2s ease;
        }

        .accordion-card.expanded .card-title {
            color: #0284c7;
            font-weight: 800;
        }

        /* Closing ERP Live Status Alert Indicators */
        .erp-status-indicator {
            display: inline-block;
            width: 8px;
            height: 8px;
            border-radius: 50%;
            flex-shrink: 0;
            transition: all 0.3s ease;
        }

        .erp-status-indicator.outdated {
            background-color: #ef4444;
            box-shadow: 0 0 0 2px rgba(239, 68, 68, 0.35);
            animation: erpPulseRed 1.8s infinite;
        }

        .erp-status-indicator.updated {
            background-color: #10b981;
            box-shadow: 0 0 0 2px rgba(16, 185, 129, 0.3);
        }

        @keyframes erpPulseRed {
            0%, 100% {
                transform: scale(0.95);
                opacity: 0.8;
            }
            50% {
                transform: scale(1.25);
                opacity: 1;
            }
        }

        .sub-item-dot.status-outdated {
            background-color: #ef4444 !important;
            box-shadow: 0 0 0 2px rgba(239, 68, 68, 0.35) !important;
            animation: erpPulseRed 1.8s infinite !important;
        }

        .sub-item-dot.status-updated {
            background-color: #10b981 !important;
            box-shadow: 0 0 0 2px rgba(16, 185, 129, 0.3) !important;
            animation: none !important;
        }

        .sub-item-status-tag {
            font-size: 0.65rem;
            font-weight: 800;
            padding: 2px 6px;
            border-radius: 4px;
            margin-left: auto;
            margin-right: 4px;
            text-transform: uppercase;
            letter-spacing: 0.2px;
            display: inline-block;
        }

        .sub-item-status-tag.tag-outdated {
            background: #fee2e2;
            color: #ef4444;
            border: 1px solid #fecaca;
        }

        .sub-item-status-tag.tag-updated {
            background: #d1fae5;
            color: #059669;
            border: 1px solid #a7f3d0;
        }

        /* Chevron indicator (▼ / ▲) */
        .accordion-chevron {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 22px;
            height: 22px;
            border-radius: 50%;
            background: #f1f5f9;
            color: var(--brand-primary);
            transition: transform 0.22s ease, background 0.2s, color 0.2s;
            flex-shrink: 0;
            margin-left: 6px;
        }

        .accordion-chevron svg {
            width: 13px;
            height: 13px;
            stroke: currentColor;
            stroke-width: 2.5;
            fill: none;
            stroke-linecap: round;
            stroke-linejoin: round;
            transition: transform 0.2s ease;
        }

        .accordion-card.expanded .accordion-chevron {
            transform: rotate(180deg);
            background: var(--brand-primary);
            color: #ffffff;
        }

        /* Expandable Sub-Reports Body */
        .accordion-body {
            max-height: 0;
            opacity: 0;
            overflow: hidden;
            transition: max-height 0.28s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.2s ease;
            background: #f8fafc;
        }

        .accordion-card.expanded .accordion-body {
            max-height: 900px;
            opacity: 1;
        }

        .sub-report-list {
            padding: 8px 10px 10px;
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

        .sub-report-item {
            display: flex;
            align-items: center;
            justify-content: space-between;
            width: 100%;
            padding: 7px 10px;
            background: #ffffff;
            border: 1.2px solid #e2e8f0;
            border-radius: 6px;
            font-family: inherit;
            cursor: pointer;
            transition: background 0.15s ease, border-color 0.15s ease, color 0.15s ease, box-shadow 0.15s ease;
            text-align: left;
            color: #334155;
            box-sizing: border-box;
            transform: none !important;
        }

        .sub-report-item:hover {
            background: #f0f7ff;
            border-color: #38bdf8;
            color: #0284c7;
            transform: none !important;
            box-shadow: 0 2px 5px rgba(2, 132, 199, 0.08);
        }

        .sub-item-left {
            display: flex;
            align-items: center;
            gap: 8px;
            flex: 1;
            min-width: 0;
        }

        .sub-item-dot {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: #94a3b8;
            flex-shrink: 0;
            transition: background-color 0.15s ease;
            transform: none !important;
        }

        .sub-item-title {
            font-size: 0.77rem;
            font-weight: 600;
            color: #334155;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            transition: color 0.15s ease;
        }

        .sub-report-item:hover .sub-item-title {
            color: #0284c7;
        }

        .sub-report-item.item-highlight-entry {
            background: linear-gradient(135deg, #f0f9ff 0%, #e0f2fe 100%);
            border-color: #7dd3fc;
            transform: none !important;
        }

        .sub-report-item.item-highlight-entry:hover {
            background: linear-gradient(135deg, #e0f2fe 0%, #bae6fd 100%);
            border-color: #38bdf8;
            transform: none !important;
            box-shadow: 0 2px 5px rgba(2, 132, 199, 0.1);
        }

        .sub-report-item.item-highlight-entry .sub-item-title {
            font-weight: 800;
            color: #0369a1;
        }

        .sub-report-item.item-highlight-entry .sub-item-dot {
            width: 6px;
            height: 6px;
            background: #0284c7;
            box-shadow: 0 0 0 2px rgba(2, 132, 199, 0.25);
        }

        .sub-report-item.item-highlight-entry .sub-item-arrow {
            color: #0284c7;
            stroke: #0284c7;
            stroke-width: 2.2;
            transform: none !important;
        }

        .sub-item-arrow {
            width: 12px;
            height: 12px;
            stroke: #94a3b8;
            stroke-width: 2.2;
            fill: none;
            flex-shrink: 0;
            transition: stroke 0.15s ease;
            transform: none !important;
        }

        .sub-report-item:hover .sub-item-arrow {
            stroke: #0284c7;
            transform: none !important;
        }

        /* MASTER Module 11 Card in Drawer Menu */
        .master-menu-card {
            margin-top: 6px;
            background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%) !important;
            border: 1.5px solid #334155 !important;
            border-radius: 10px !important;
            box-shadow: 0 4px 14px rgba(15, 23, 42, 0.2) !important;
            cursor: pointer;
            transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1) !important;
        }

        .master-menu-card:hover {
            border-color: #38bdf8 !important;
            transform: translateY(-2px) !important;
            box-shadow: 0 6px 18px rgba(15, 23, 42, 0.3) !important;
        }

        .master-header-btn {
            background: transparent !important;
            padding: 10px 14px !important;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .master-icon-badge {
            width: 26px;
            height: 26px;
            border-radius: 7px;
            background: #334155;
            color: #38bdf8;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        .master-icon-badge svg {
            width: 15px;
            height: 15px;
        }

        .master-title-text {
            color: #ffffff !important;
            font-size: 0.83rem !important;
            font-weight: 800 !important;
            letter-spacing: 0.3px;
        }

        .master-action-tag {
            font-size: 0.66rem;
            font-weight: 800;
            color: #0f172a;
            background: #38bdf8;
            padding: 3px 8px;
            border-radius: 5px;
            transition: all 0.2s ease;
        }

        .master-menu-card:hover .master-action-tag {
            background: #ffffff;
            color: #0f172a;
        }

        .sub-report-item:active {
            transform: none !important;
            background: #bae6fd;
        }

        /* ==========================================================================
           6. Full-Width Bottom Footer Bar
           ========================================================================== */
        .workspace-footer {
            width: 100%;
            height: 60px;
            background: var(--navbar-bg);
            border-top: 1px solid var(--navbar-border);
            backdrop-filter: blur(12px);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 0 32px;
            margin-top: auto;
        }

        .footer-inner {
            width: 100%;
            max-width: 100%;
            display: flex;
            align-items: center;
            justify-content: space-between;
            font-size: 0.86rem;
        }

        .status-indicator {
            display: flex;
            align-items: center;
            gap: 8px;
            font-weight: 600;
            color: #1e293b;
        }

        .status-pulse {
            width: 8px;
            height: 8px;
            background-color: #22c55e;
            border-radius: 50%;
            box-shadow: 0 0 0 3px rgba(34, 197, 94, 0.22);
            animation: pulse 2s infinite;
        }

        .footer-tagline {
            font-weight: 500;
            color: var(--text-muted);
        }

        @keyframes pulse {
            0%, 100% { opacity: 1; transform: scale(1); }
            50% { opacity: 0.55; transform: scale(0.85); }
        }

        /* Toast Feedback Notification */
        #notification-toast {
            position: fixed;
            bottom: 24px;
            left: 50%;
            transform: translateX(-50%) translateY(100px);
            background: #0f172a;
            color: #f8fafc;
            padding: 13px 24px;
            border-radius: 12px;
            font-size: 0.92rem;
            font-weight: 600;
            box-shadow: 0 14px 30px rgba(0,0,0,0.25);
            display: flex;
            align-items: center;
            gap: 10px;
            z-index: 1000;
            opacity: 0;
            pointer-events: none;
            transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
            border: 1px solid rgba(255,255,255,0.08);
        }

        #notification-toast.show {
            transform: translateX(-50%) translateY(0);
            opacity: 1;
        }

        #notification-toast svg {
            width: 18px;
            height: 18px;
            stroke: #38bdf8;
            flex-shrink: 0;
        }

        /* ==========================================================================
           7. Corner Profile Dropdown Menu Styling
           ========================================================================== */
        .profile-dropdown-menu {
            position: absolute;
            top: calc(100% + 14px);
            right: 0;
            width: 360px;
            background: linear-gradient(145deg, #f0f7fe 0%, #e8f3fc 50%, #f6faff 100%);
            border-radius: 20px;
            padding: 30px 24px 24px;
            box-shadow: 0 20px 45px -10px rgba(15, 41, 66, 0.18), 0 0 0 1px rgba(186, 215, 243, 0.85);
            border: 1.5px solid rgba(186, 215, 243, 0.85);
            z-index: 1000;
            opacity: 0;
            visibility: hidden;
            transform: translateY(-8px) scale(0.96);
            transform-origin: top right;
            transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
            text-align: center;
        }

        .profile-dropdown-menu.show {
            opacity: 1;
            visibility: visible;
            transform: translateY(0) scale(1);
        }

        /* Close Button in Dropdown */
        .btn-dropdown-close {
            position: absolute;
            top: 14px;
            right: 14px;
            width: 30px;
            height: 30px;
            border-radius: 50%;
            background: #f1f5f9;
            border: 1px solid #e2e8f0;
            color: #64748b;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.2s ease;
            outline: none;
        }

        .btn-dropdown-close:hover {
            background: #fee2e2;
            color: #ef4444;
            border-color: #fca5a5;
            transform: rotate(90deg);
        }

        /* Circular Profile Photo in Dropdown */
        .profile-photo-container {
            width: 92px;
            height: 92px;
            margin: 0 auto 14px;
            border-radius: 50%;
            padding: 3px;
            background: linear-gradient(135deg, #06b6d4 0%, #0284c7 100%);
            box-shadow: 0 6px 18px rgba(6, 182, 212, 0.28);
            position: relative;
        }

        .profile-photo {
            width: 100%;
            height: 100%;
            border-radius: 50%;
            object-fit: cover;
            object-position: 50% 18%;
            transform: scale(1.15);
            image-rendering: -webkit-optimize-contrast;
            filter: contrast(1.08) brightness(1.03) saturate(1.04);
            background: #e0f2fe;
            display: block;
            border: 2.5px solid #ffffff;
        }

        .profile-avatar-fallback {
            width: 100%;
            height: 100%;
            border-radius: 50%;
            background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%);
            color: #ffffff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2rem;
            font-weight: 800;
            border: 2.5px solid #ffffff;
        }

        .profile-name {
            font-size: 1.35rem;
            font-weight: 800;
            color: var(--text-heading);
            line-height: 1.2;
            margin-bottom: 3px;
            letter-spacing: -0.3px;
        }

        .profile-designation {
            font-size: 0.88rem;
            font-weight: 600;
            color: var(--brand-primary);
            margin-bottom: 18px;
        }

        .profile-divider {
            height: 1px;
            background: #e2e8f0;
            margin: 0 0 16px;
        }

        /* Information Details List */
        .profile-info-list {
            display: flex;
            flex-direction: column;
            gap: 8px;
            text-align: left;
        }

        .profile-info-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 10px 14px;
            background: rgba(255, 255, 255, 0.85);
            border: 1px solid rgba(186, 215, 243, 0.75);
            border-radius: 10px;
            box-shadow: 0 2px 6px rgba(2, 132, 199, 0.04);
            backdrop-filter: blur(4px);
            transition: background-color 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
        }

        .profile-info-row:hover {
            background: #ffffff;
            border-color: #93c5fd;
            box-shadow: 0 4px 12px rgba(2, 132, 199, 0.1);
        }

        .profile-info-label {
            font-size: 0.85rem;
            font-weight: 600;
            color: var(--text-muted);
        }

        .profile-info-value {
            font-size: 0.88rem;
            font-weight: 700;
            color: var(--text-heading);
            text-align: right;
        }

        /* ==========================================================================
           8. Mobile & Tablet Responsiveness
           ========================================================================== */
        @media (max-width: 1280px) {
            .dashboard-three-col-layout {
                grid-template-columns: 1fr;
                gap: 24px;
            }

            .dashboard-center-panel {
                order: -1;
            }

            .executive-kpi-strip {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @media (max-width: 640px) {
            .executive-kpi-strip {
                grid-template-columns: 1fr;
            }
        }

        @media (max-width: 880px) {
            .workspace-navbar {
                height: auto;
                padding: 14px 18px;
            }

            .navbar-inner {
                flex-direction: column;
                gap: 12px;
                align-items: flex-start;
            }

            .nav-user-controls {
                width: 100%;
                justify-content: space-between;
            }

            .workspace-main {
                padding: 20px 12px 36px;
            }

            .welcome-hero-card {
                padding: 36px 20px 32px;
                margin-top: 16px;
                border-radius: 20px;
            }

            .welcome-heading {
                font-size: 2.2rem;
            }

            .welcome-company-title {
                font-size: 2.4rem;
            }

            .welcome-division-tag {
                font-size: 0.95rem;
                padding: 8px 16px;
            }

            .reports-drawer {
                width: 100%;
                max-width: 100vw;
            }

            /* Single column grid on smaller devices */
            .reports-grid {
                grid-template-columns: 1fr;
                gap: 14px;
            }

            .report-card {
                min-height: 74px;
                padding: 14px 18px;
            }

            .card-number {
                width: 36px;
                height: 36px;
                min-width: 36px;
                font-size: 0.92rem;
                margin-right: 14px;
            }

            .card-title {
                font-size: 0.96rem;
            }

            .card-desc {
                font-size: 0.78rem;
            }

            .workspace-footer {
                height: auto;
                padding: 14px 18px;
            }

            .footer-inner {
                flex-direction: column;
                gap: 8px;
                text-align: center;
            }
        }
    
        /* ==========================================================================
           8. Department & Reports Hub View Styling (Matches Screenshot Exactly)
           ========================================================================== */
        #departmentHubView {
            display: none;
            flex-direction: row;
            min-height: 100vh;
            width: 100%;
            background-color: #f1f5f9;
        }

        .dept-hub-sidebar-dock {
            width: 320px;
            min-width: 320px;
            max-width: 320px;
            height: 100vh;
            position: sticky;
            top: 0;
            left: 0;
            background: #f8fafc;
            border-right: 1.5px solid #cbd5e1;
            display: flex;
            flex-direction: column;
            z-index: 500;
            box-shadow: 4px 0 20px rgba(15, 41, 66, 0.08);
            flex-shrink: 0;
            user-select: none;
        }

        .dept-hub-main-area {
            flex: 1;
            min-width: 0;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
            overflow-y: auto;
            background: #f8fafc;
        }

        .dept-hub-navbar {
            background: linear-gradient(135deg, #0a1e33 0%, #0f2942 50%, #1e3a5f 100%);
            color: #ffffff;
            padding: 12px 24px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-bottom: 1.5px solid rgba(186, 215, 243, 0.25);
            box-shadow: 0 4px 15px rgba(15, 41, 66, 0.15);
            flex-shrink: 0;
        }

        .dept-hub-nav-left {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .btn-return-kpi {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            padding: 7px 14px;
            background: rgba(255, 255, 255, 0.12);
            border: 1px solid rgba(255, 255, 255, 0.25);
            border-radius: 8px;
            color: #ffffff;
            font-size: 0.80rem;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.2s ease;
            text-decoration: none;
        }

        .btn-return-kpi:hover {
            background: #0284c7;
            border-color: #38bdf8;
            transform: translateY(-1px);
        }

        .dept-hub-content-container {
            padding: 35px 35px 60px;
            max-width: 1240px;
            margin: 0 auto;
            width: 100%;
        }

        .dept-hub-panel {
            background: #ffffff;
            border: 1.5px solid #e2e8f0;
            border-radius: 14px;
            box-shadow: 0 4px 25px rgba(15, 41, 66, 0.05);
            padding: 35px 35px 45px;
        }

        /* Centered Header with Lines (Exact Screenshot Match) */
        .dept-hub-heading-wrap {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 20px;
            margin-bottom: 22px;
        }

        .dept-hub-divider-line {
            flex: 1;
            max-width: 160px;
            height: 1.5px;
            background: #cbd5e1;
        }

        .dept-hub-title {
            font-size: 1.45rem;
            font-weight: 300;
            color: #475569;
            letter-spacing: 0.5px;
            margin: 0;
            font-family: inherit;
            white-space: nowrap;
        }

        .dept-hub-subtitle {
            text-align: center;
            font-size: 0.82rem;
            color: #64748b;
            margin: 0 0 32px;
        }

        /* 2-3 Column Grid of Department Cards */
        .dept-cards-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(310px, 1fr));
            gap: 16px;
        }

        /* Department Button Card - Luxury Design */
        .dept-card-btn {
            display: flex !important;
            align-items: center !important;
            gap: 14px !important;
            background: #ffffff !important;
            border: 1.5px solid #e2e8f0 !important;
            border-radius: 13px !important;
            padding: 13px 18px !important;
            cursor: pointer !important;
            text-align: left !important;
            transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1) !important;
            outline: none !important;
            user-select: none !important;
            box-shadow: 0 2px 7px rgba(15, 41, 66, 0.04) !important;
            position: relative !important;
            min-height: 66px !important;
            box-sizing: border-box !important;
        }

        .dept-card-btn:hover {
            transform: translateY(-3px) scale(1.012) !important;
            box-shadow: 0 10px 24px rgba(15, 41, 66, 0.1) !important;
        }

        .dept-card-icon-box {
            width: 44px !important;
            height: 44px !important;
            border-radius: 11px !important;
            display: flex !important;
            align-items: center !important;
            justify-content: center !important;
            flex-shrink: 0 !important;
            box-shadow: 0 3px 10px rgba(0, 0, 0, 0.1) !important;
            transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.25s !important;
        }

        .dept-card-btn:hover .dept-card-icon-box {
            transform: scale(1.12) rotate(3deg) !important;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.16) !important;
        }

        .dept-card-icon-box svg {
            width: 22px !important;
            height: 22px !important;
        }

        .dept-card-info {
            flex: 1 !important;
            min-width: 0 !important;
        }

        .dept-card-name {
            font-size: 1.02rem !important;
            font-weight: 800 !important;
            color: #0f2942 !important;
            line-height: 1.3 !important;
            white-space: nowrap !important;
            overflow: hidden !important;
            text-overflow: ellipsis !important;
            letter-spacing: -0.2px !important;
        }

        .dept-card-desc,
        .dept-card-badge {
            display: none !important;
        }

        /* Unique Icon Jewel Badges & Hover Glow per Theme */
        /* 1. All Report Summary - Sapphire Blue */
        .dept-theme-mod-01 .dept-card-icon-box {
            background: linear-gradient(135deg, #dbeafe 0%, #93c5fd 100%) !important;
            color: #1d4ed8 !important;
            border: 1.5px solid #60a5fa !important;
            box-shadow: 0 3px 10px rgba(29, 78, 216, 0.25) !important;
        }
        .dept-theme-mod-01:hover { border-color: #60a5fa !important; }
        .dept-theme-mod-01.active-dept {
            background: linear-gradient(135deg, #ffffff 0%, #eff6ff 100%) !important;
            border-color: #3b82f6 !important;
            border-left: 5px solid #1d4ed8 !important;
            box-shadow: 0 8px 24px rgba(37, 99, 235, 0.2) !important;
        }
        .dept-theme-mod-01.active-dept .dept-card-name { color: #1e40af !important; }

        /* 2. Daily Check Report - Amber Gold */
