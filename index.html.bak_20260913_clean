    <!-- Anti-Cache & Auto-Refresh Meta Tags (Ensures Realtime Mobile & Browser Updates) -->
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate">
    <meta http-equiv="Pragma" content="no-cache">
    <meta http-equiv="Expires" content="0">
    <script>
        // Automatic Cache Purge & Service Worker Killer
        (function() {
            if ('serviceWorker' in navigator) {
                navigator.serviceWorker.getRegistrations().then(function(registrations) {
                    for (var i = 0; i < registrations.length; i++) {
                        registrations[i].unregister();
                    }
                }).catch(function(e){});
            }
            if ('caches' in window) {
                caches.keys().then(function(names) {
                    for (var i = 0; i < names.length; i++) {
                        caches.delete(names[i]);
                    }
                }).catch(function(e){});
            }
        })();
    </script>

    <!-- Instant Zero-FOUC View Resolver (Eliminates any login screen or interface flash on reload) -->
    <script>
        (function() {
            try {
                var isAuth = (sessionStorage.getItem('portal_auth_status') === 'true');
                var role = (sessionStorage.getItem('portal_auth_role') || '').toUpperCase();
                var sig = sessionStorage.getItem('portal_auth_sig') || '';
                var expectedSig = (role === 'VIEW') ? btoa('VIEW:::MEP_SECURE_PORTAL_2026') : btoa('ADMIN:::MEP_SECURE_PORTAL_2026');
                var isValid = isAuth && (role === 'ADMIN' || role === 'VIEW') && (sig === expectedSig);

                var curView = sessionStorage.getItem('portal_current_view') || 'main';
                var urlParams = new URLSearchParams(window.location.search);
                var viewParam = urlParams.get('view');
                if (viewParam === 'modules') curView = 'modules';
                else if (viewParam === 'hub') curView = 'hub';
                else if (viewParam === 'hrm') curView = 'hrm';
                else if (viewParam === 'mis') curView = 'mis';
                else if (viewParam === 'main' || viewParam === 'production' || viewParam === 'dashboard') curView = 'main';

                var s = document.createElement('style');
                s.id = 'zero-fouc-instant-view-style';
                
                if (isValid) {
                    var targetId = 'mainInterfaceView';
                    if (curView === 'modules') targetId = 'moduleSelectionView';
                    else if (curView === 'hub') targetId = 'departmentHubView';
                    else if (curView === 'hrm') targetId = 'hrmModuleView';
                    else if (curView === 'mis') targetId = 'misSelectionView';

                    s.textContent = 
                        '#loginView { display: none !important; visibility: hidden !important; opacity: 0 !important; } ' +
                        '#' + targetId + ' { display: flex !important; visibility: visible !important; opacity: 1 !important; } ' +
                        '.app-workspace:not(#' + targetId + '), .module-selection-grid-shell:not(#' + targetId + '), .department-hub-shell:not(#' + targetId + '), .hrm-workspace-shell:not(#' + targetId + ') { display: none !important; }';
                } else {
                    s.textContent = 
                        '#loginView { display: flex !important; visibility: visible !important; opacity: 1 !important; } ' +
                        '#mainInterfaceView, #moduleSelectionView, #departmentHubView, #hrmModuleView, #misSelectionView { display: none !important; }';
                }
                (document.head || document.documentElement).appendChild(s);
            } catch(e) {}
        })();
    </script>

