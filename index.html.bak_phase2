                                <span class="live-update-badge">Live Sync</span>
                            </div>
                            <div class="branch-table-wrap">
                                <table class="branch-summary-table">
                                    <thead>
                                        <tr>
                                            <th style="text-align:left;">Branch</th>
                                            <th style="text-align:right;">Target</th>
                                            <th style="text-align:right;">Achievement</th>
                                            <th style="text-align:right;">Pending</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <!-- Row 1: Fan Assemble -->
                                        <tr>
                                            <td class="col-branch">
                                                <span class="branch-dot dot-blue"></span>
                                                <span>Fan Assemble</span>
                                            </td>
                                            <td class="col-num num-target" id="tblTargetFan">20,000</td>
                                            <td class="col-num num-achieve" id="tblAchieveFan">15,000</td>
                                            <td class="col-num num-pending" id="tblPendingFan">5,000</td>
                                        </tr>
                                        <!-- Row 2: Blade & Dimmer -->
                                        <tr>
                                            <td class="col-branch">
                                                <span class="branch-dot dot-cyan"></span>
                                                <span>Blade &amp; Dimmer</span>
                                            </td>
                                            <td class="col-num num-target" id="tblTargetBlade">10,000</td>
                                            <td class="col-num num-achieve" id="tblAchieveBlade">5,000</td>
                                            <td class="col-num num-pending" id="tblPendingBlade">5,000</td>
                                        </tr>
                                        <!-- Row 3: Armature & Winding -->
                                        <tr>
                                            <td class="col-branch">
                                                <span class="branch-dot dot-amber"></span>
                                                <span>Armature &amp; Winding</span>
                                            </td>
                                            <td class="col-num num-target" id="tblTargetArm">10,000</td>
                                            <td class="col-num num-achieve" id="tblAchieveArm">6,500</td>
                                            <td class="col-num num-pending" id="tblPendingArm">3,500</td>
                                        </tr>
                                    </tbody>
                                    <tfoot>
                                        <tr class="branch-total-row">
                                            <td style="color:#0f2942;">TOTAL</td>
                                            <td class="col-num" id="tblTargetTotal">40,000</td>
                                            <td class="col-num num-achieve-total" id="tblAchieveTotal">26,500</td>
                                            <td class="col-num num-pending-total" id="tblPendingTotal">13,500</td>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                        </div>

                        <!-- ⑥ Zone 6: Achievement vs Pending Percentage Gauge -->
                        <div class="perf-gauge-card">
                            <div class="perf-gauge-header">
                                <span class="perf-gauge-title">
                                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#0284c7" stroke-width="2.2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                                    ACHIEVEMENT VS PENDING
                                </span>
                                <span style="font-size:0.68rem; color:#64748b; font-weight:700;">Formula: Achieved ÷ Target</span>
                            </div>
                            <div class="gauge-display-container">
                                <!-- Semi-Circular Gauge SVG -->
                                <div class="semi-gauge-box">
                                    <svg viewBox="0 0 220 120" class="semi-gauge-svg">
                                        <defs>
                                            <linearGradient id="gaugeGradAchieve" x1="0" y1="0" x2="1" y2="0">
                                                <stop offset="0%" stop-color="#0284c7"/>
                                                <stop offset="100%" stop-color="#38bdf8"/>
                                            </linearGradient>
                                            <linearGradient id="gaugeGradPending" x1="0" y1="0" x2="1" y2="0">
                                                <stop offset="0%" stop-color="#f59e0b"/>
                                                <stop offset="100%" stop-color="#fbbf24"/>
                                            </linearGradient>
                                        </defs>
                                        <!-- Base Track Arc (r=85, cx=110, cy=105, length = pi*85 = ~267) -->
                                        <path d="M 25 105 A 85 85 0 0 1 195 105" fill="none" stroke="#e2e8f0" stroke-width="18" stroke-linecap="round"/>
                                        <!-- Pending Arc (Full arc background in amber) -->
                                        <path d="M 25 105 A 85 85 0 0 1 195 105" fill="none" stroke="url(#gaugeGradPending)" stroke-width="18" stroke-linecap="round" stroke-dasharray="267" stroke-dashoffset="0"/>
                                        <!-- Achievement Arc (62.5% of 267 = 167 length) -->
                                        <path id="gaugeAchieveArc" d="M 25 105 A 85 85 0 0 1 195 105" fill="none" stroke="url(#gaugeGradAchieve)" stroke-width="18" stroke-linecap="round" stroke-dasharray="167 267" stroke-dashoffset="0" style="transition: stroke-dasharray 0.8s ease;"/>
                                    </svg>
                                    <div class="gauge-center-content">
                                        <div class="gauge-big-pct" id="valGaugeAchievePct">62.5%</div>
                                        <div class="gauge-big-label">ACHIEVEMENT</div>
                                    </div>
                                </div>

                                <!-- Dual Split Metrics Row -->
                                <div class="gauge-metrics-row">
                                    <div class="gauge-metric-box metric-pending">
                                        <div class="metric-head">
                                            <span class="branch-dot dot-amber"></span>
                                            <span>PENDING</span>
                                        </div>
                                        <div class="metric-val" id="valGaugePendingPct">37.5%</div>
                                        <div class="metric-sub" id="valGaugePendingPcs">15,000 PCS</div>
                                    </div>
                                    <div class="gauge-metric-divider"></div>
                                    <div class="gauge-metric-box metric-total">
                                        <div class="metric-head">
                                            <span class="branch-dot dot-dark"></span>
                                            <span>TOTAL CYCLE</span>
                                        </div>
                                        <div class="metric-val">100%</div>
                                        <div class="metric-sub" id="valGaugeTargetPcs">40,000 PCS</div>
                                    </div>
                                </div>

                                <!-- Mathematical Footnote -->
                                <div class="gauge-formula-footnote">
                                    <span id="valGaugeFormulaFootnote">Completed (25,000) ÷ Target (40,000) × 100 = <strong>62.5%</strong> | Pending = <strong>37.5%</strong></span>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>

            </main>
        </div>
    </div>

    <!-- ==========================================================================
         VIEW 3: Full-Screen Enterprise ERP Dashboard Workspace
         ========================================================================== -->
    <div class="app-workspace" id="dashboardView" style="display:none !important;">
        
        <!-- Full-Width Top Navigation Bar -->
