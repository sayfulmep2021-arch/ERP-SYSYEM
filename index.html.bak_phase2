                    <!-- Right Column: ⑤ Branch Summary + ⑥ Achievement Gauge -->
                    <div class="perf-stats-column">
                        
                        <!-- ⑤ Zone 5: Branch-wise Production Summary Table -->
                        <div class="branch-summary-card">
                            <div class="branch-summary-header">
                                <span class="branch-summary-title">
                                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#0284c7" stroke-width="2.2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
                                    BRANCH PRODUCTION SUMMARY
