            <!-- Right Main Workspace: Choose Your Report Hub -->
            <main class="dept-hub-main-area">
                <!-- Main Content Container -->
                <div class="dept-hub-content-container">
                <div class="dept-hub-panel">
                    
                    <!-- Centered Heading with Lines (Exact Screenshot Match) -->
                    <div class="dept-hub-heading-wrap">
                        <span class="dept-hub-divider-line"></span>
