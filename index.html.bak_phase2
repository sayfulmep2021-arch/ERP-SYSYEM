<!DOCTYPE html>
<html lang="en">
<head>
    <!-- Anti-Cache & Auto-Refresh Meta Tags (Ensures Realtime Mobile & Browser Updates) -->
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate">
    <meta http-equiv="Pragma" content="no-cache">
    <meta http-equiv="Expires" content="0">
    <script>
        // Automatic Cache Purge & Service Worker Killer
        (function() {
            if ('serviceWorker' in navigator) {
                navigator.serviceWorker.getRegistrations().then(function(registrations) {
                    for (var i = 0; i < registrations.length; i++) {
                        registrations[i].unregister();
                    }
                }).catch(function(e){});
            }
            if ('caches' in window) {
                caches.keys().then(function(names) {
                    for (var i = 0; i < names.length; i++) {
                        caches.delete(names[i]);
                    }
                }).catch(function(e){});
            }
        })();
    </script>

    <link rel="stylesheet" href="corporate_design_system.css?v=20260905">
    <link rel="stylesheet" href="report_sidebar.css?v=20260905">
    <script src="notification_system.js?v=20260905"></script>
    <script src="smart_firebase_sync.js?v=20260905"></script>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    <title>Sayful Islam (Fan) | Report Management Portal</title>

    <!-- PWA Web App Manifest & Desktop Metadata -->
    <link rel="manifest" href="manifest.json">
    <meta name="theme-color" content="#0284c7">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="MEP Portal">
    <link rel="icon" type="image/x-icon" href="favicon.ico">
    <link rel="icon" type="image/png" sizes="192x192" href="icon-192.png">
    <link rel="icon" type="image/png" sizes="512x512" href="icon-512.png">
    <link rel="apple-touch-icon" href="icon-192.png">
    
    <!-- Google Fonts for Modern Corporate Typography -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;600;700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="portal_styles.css">
</head>
<body class="corp-themed">

    <!-- ==========================================================================
         VIEW 1: Corporate Authentication View (Login Screen)
         ========================================================================== -->
    <div class="auth-wrapper" id="loginView" role="region" aria-label="Authentication Panel">
        <!-- Ambient Pastel Background Decorative Elements -->
        <div class="auth-bg-decor decor-orb-1"></div>
        <div class="auth-bg-decor decor-orb-2"></div>
        <div class="auth-bg-decor decor-orb-3"></div>
        <div class="auth-bg-decor decor-orb-4"></div>
        <div class="auth-bg-pattern"></div>

        <div class="auth-split-card">
            
            <!-- Left Column: Form Section -->
            <div class="auth-form-side">
                <div class="auth-brand-area">
                    <div class="auth-logo-badge">
                        <img src="sayful_logo.png" alt="Sayful Fan" class="auth-brand-logo-img">
                    </div>
                </div>

                <!-- Error Notification Alert -->
                <div class="error-alert" id="loginError" role="alert" aria-live="assertive">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
                    <span id="loginErrorMsg">Invalid Password! Please try again.</span>
                </div>

                <!-- Login Form -->
                <form id="loginForm" class="auth-form-body" onsubmit="handleLogin(event)" autocomplete="off">
                    <!-- Hidden input holding current role name for form submission / script reads -->
                    <input type="hidden" id="username" value="ADMIN">

                    <!-- Interactive Username Selector -->
                    <div class="form-group">
                        <label class="form-label" for="roleSelectorBtn">Username</label>
                        <div class="username-custom-dropdown" id="userRoleDropdown">
                            <button type="button" class="username-select-btn" id="roleSelectorBtn" onclick="toggleRoleDropdown()" aria-expanded="false" aria-haspopup="true">
                                <span class="role-icon-box" id="activeRoleIcon">
                                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2">
                                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                                    </svg>
                                </span>
                                <div class="role-text-wrap">
                                    <span class="role-name-display" id="activeRoleName">ADMIN</span>
                                    <span class="role-tag-display" id="activeRoleTag">System Administrator (Full Edit Access)</span>
                                </div>
                                <svg class="role-chevron" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5">
                                    <polyline points="6 9 12 15 18 9"></polyline>
                                </svg>
                            </button>

                            <div class="role-dropdown-menu" id="roleDropdownMenu">
                                <div class="role-menu-item active" id="roleItemAdmin" onclick="selectRole('ADMIN')">
                                    <div class="role-item-icon admin">
                                        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.2">
                                            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                                        </svg>
                                    </div>
                                    <div class="role-item-info">
                                        <div class="role-item-title">ADMIN</div>
                                        <div class="role-item-desc">Full edit, entry &amp; cloud sync permissions</div>
                                    </div>
                                    <span class="role-item-check" id="checkAdmin">✓</span>
                                </div>

                                <div class="role-menu-item" id="roleItemView" onclick="selectRole('View')">
                                    <div class="role-item-icon view">
                                        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.2">
                                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                            <circle cx="12" cy="12" r="3"></circle>
                                        </svg>
                                    </div>
                                    <div class="role-item-info">
                                        <div class="role-item-title">View</div>
                                        <div class="role-item-desc">Read-Only access to dashboards, hubs &amp; reports</div>
                                    </div>
                                    <span class="role-item-check" id="checkView" style="display:none;">✓</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Password Field -->
                    <div class="form-group">
                        <div class="form-label-row">
                            <label class="form-label" for="password">Password</label>
                            <span class="pwd-role-hint" id="pwdRoleHint">Security PIN</span>
                        </div>
                        <div class="input-wrapper">
                            <input type="password" 
                                   id="password" 
                                   class="form-input has-toggle" 
                                   placeholder="Enter Password" 
                                   value="" 
                                   autocomplete="new-password" 
                                   required 
                                   autofocus>
                            <!-- Password Visibility Toggle Button -->
                            <button type="button" 
                                    class="pwd-toggle-btn" 
                                    id="togglePasswordBtn" 
                                    onclick="togglePasswordVisibility()" 
                                    aria-label="Toggle password visibility"
                                    title="Show / Hide Password">
                                <!-- Eye Icon (Default) -->
                                <svg id="eyeIcon" viewBox="0 0 24 24">
                                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                    <circle cx="12" cy="12" r="3"></circle>
                                </svg>
                                <!-- Eye Off Icon (Hidden initially) -->
                                <svg id="eyeOffIcon" viewBox="0 0 24 24" style="display: none;">
                                    <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
                                    <line x1="1" y1="1" x2="23" y2="23"></line>
                                </svg>
                            </button>
                        </div>
                    </div>

                    <button type="submit" class="btn-signin" id="loginBtn">
                        <span>Login</span>
                        <svg viewBox="0 0 24 24"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                    </button>
                </form>
            </div>

            <!-- Right Column: FAN ASSEMBLE Circular Ecosystem Showcase -->
            <div class="auth-showcase-side">
                <div class="showcase-header">
                    <div class="showcase-badge">
                        <span class="pulse-dot"></span>
                        <span>MANUFACTURING ECOSYSTEM</span>
                    </div>
                    <h2 class="showcase-title">FAN ASSEMBLE</h2>
                </div>

                <!-- Orbit Stage -->
                <div class="orbit-stage">
                    <!-- SVG Geometric Rings and Connecting Hub Rays -->
                    <svg class="orbit-lines-svg" viewBox="0 0 400 380" fill="none">
                        <!-- Concentric Rings -->
                        <circle cx="200" cy="190" r="126" stroke="#bae6fd" stroke-width="1.8" stroke-dasharray="5 5" opacity="0.85"/>
                        <circle cx="200" cy="190" r="68" stroke="rgba(2, 132, 199, 0.18)" stroke-width="1.2" stroke-dasharray="3 3"/>
                        
                        <!-- Rays to 6 Nodes -->
                        <!-- Top (12 o'clock) -->
                        <line x1="200" y1="140" x2="200" y2="52" stroke="#bae6fd" stroke-width="1.5" stroke-dasharray="3 3"/>
                        <!-- Top Right (2 o'clock) -->
                        <line x1="235" y1="165" x2="295" y2="116" stroke="#bae6fd" stroke-width="1.5" stroke-dasharray="3 3"/>
                        <!-- Bottom Right (4 o'clock) -->
                        <line x1="235" y1="215" x2="295" y2="264" stroke="#bae6fd" stroke-width="1.5" stroke-dasharray="3 3"/>
                        <!-- Bottom (6 o'clock) -->
                        <line x1="200" y1="240" x2="200" y2="328" stroke="#bae6fd" stroke-width="1.5" stroke-dasharray="3 3"/>
                        <!-- Bottom Left (8 o'clock) -->
                        <line x1="165" y1="215" x2="105" y2="264" stroke="#bae6fd" stroke-width="1.5" stroke-dasharray="3 3"/>
                        <!-- Top Left (10 o'clock) -->
                        <line x1="165" y1="165" x2="105" y2="116" stroke="#bae6fd" stroke-width="1.5" stroke-dasharray="3 3"/>
                    </svg>

                    <!-- Center Hub: Assemble -->
                    <div class="orbit-hub-center" title="Core Fan Assembly Division">
                        <svg class="orbit-hub-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="3"></circle>
                            <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
                        </svg>
                        <span class="orbit-hub-title">Assemble</span>
                    </div>

                    <!-- 1. Node Top: Power Press & Stamping -->
                    <div class="orbit-node node-top" title="Power Press & Stamping Section">
                        <span class="orbit-node-icon" style="background:#eff6ff; color:#2563eb;">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                                <line x1="3" y1="9" x2="21" y2="9"></line>
                                <line x1="9" y1="21" x2="9" y2="9"></line>
                            </svg>
                        </span>
                        <span class="orbit-node-label">Power Press &amp; Stamping</span>
                    </div>

                    <!-- 2. Node Top-Right: Dhalai & Dai Casting -->
                    <div class="orbit-node node-top-right" title="Dhalai & Dai Casting Section">
                        <span class="orbit-node-icon" style="background:#fef3c7; color:#d97706;">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"></path>
                            </svg>
                        </span>
                        <span class="orbit-node-label">Dhalai &amp; Dai Casting</span>
                    </div>

                    <!-- 3. Node Bottom-Right: Armature & Winding -->
                    <div class="orbit-node node-bottom-right" title="Armature & Winding Section">
                        <span class="orbit-node-icon" style="background:#ecfdf5; color:#059669;">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
                            </svg>
                        </span>
                        <span class="orbit-node-label">Armature &amp; Winding</span>
                    </div>

                    <!-- 4. Node Bottom: Lathe -->
                    <div class="orbit-node node-bottom" title="Lathe Machine Section">
                        <span class="orbit-node-icon" style="background:#f1f5f9; color:#475569;">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="12" r="10"></circle>
                                <circle cx="12" cy="12" r="4"></circle>
                                <line x1="4.93" y1="4.93" x2="9.17" y2="9.17"></line>
                                <line x1="14.83" y1="14.83" x2="19.07" y2="19.07"></line>
                            </svg>
                        </span>
                        <span class="orbit-node-label">Lathe</span>
                    </div>

                    <!-- 5. Node Bottom-Left: Auto Powder Coating -->
                    <div class="orbit-node node-bottom-left" title="Auto Powder Coating Section">
                        <span class="orbit-node-icon" style="background:#fdf4ff; color:#a855f7;">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"></path>
                            </svg>
                        </span>
                        <span class="orbit-node-label">Auto Powder Coating</span>
                    </div>

                    <!-- 6. Node Top-Left: Blade & Dimmer -->
                    <div class="orbit-node node-top-left" title="Blade & Dimmer Section">
                        <span class="orbit-node-icon" style="background:#e0f2fe; color:#0284c7;">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="12" r="2"></circle>
                                <path d="M16.24 7.76a6 6 0 0 1 0 8.49m-8.48-.01a6 6 0 0 1 0-8.49m11.31-2.82a10 10 0 0 1 0 14.14m-14.14 0a10 10 0 0 1 0-14.14"></path>
                            </svg>
                        </span>
                        <span class="orbit-node-label">Blade &amp; Dimmer</span>
                    </div>
                </div>
            </div>

        </div>
    </div>

    <!-- ==========================================================================
         VIEW 2: Enterprise Main Overview Interface (Matches Reference Screenshot 2)
         ========================================================================== -->
    <div class="app-workspace" id="mainInterfaceView" style="display:none; flex-direction:column; height:100vh; overflow:hidden;">
        
        <!-- Full-Width Top Navigation Bar -->
        <header class="workspace-navbar">
            <div class="navbar-inner">
                <!-- Left: Permanent Brand Bar - Smart Time Management (Clean, Minimal, No Interface Text) -->
                <div class="smart-brand-card">
                    <span class="smart-brand-text">Smart Time Management</span>
                </div>

                <!-- Right: Live Day/Time & Sayful Islam Profile Dropdown -->
                <div class="nav-user-controls">
                    <!-- View-Only Mode Status Badge -->
                    <div class="smart-view-only-badge" style="display:none;" title="View-Only Mode: Data entry and editing are disabled">
                        <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                        <span>View Only</span>
                    </div>

                    <!-- Live Day & Time Top Corner Badge with Integrated Realtime Cloud Status -->
                    <div class="live-clock-badge" title="Live System Day & Time">
                        <span class="smart-cloud-status-badge" id="mainCloudStatusBadge" title="Realtime Cloud: Connected (Live Sync)">
                            <span class="cloud-pulse-dot"></span>
                            <span class="cloud-status-text">Live</span>
                        </span>
                        <div class="live-clock-info">
                            <span class="live-day-text">Loading day...</span>
                            <span class="live-time-text">--:--:-- --</span>
                        </div>
                    </div>

                    <div class="profile-dropdown-wrapper">
                        <!-- Top Corner Profile Round Photo & Name Component -->
                        <div class="user-brand-card" 
                             id="mainUserProfileBtn"
                             onclick="toggleProfileDropdown(event)" 
                             role="button" 
                             tabindex="0" 
                             aria-haspopup="true"
                             aria-expanded="false"
                             title="Sayful Islam - Click to view Profile Details">
                            
                            <!-- Circular Avatar Photo with Clean Cyan-Blue Border -->
                            <div class="user-avatar-frame" style="width:34px; height:34px; border-radius:50%; overflow:hidden; border:2px solid #0284c7; display:flex; align-items:center; justify-content:center; flex-shrink:0;">
                                <img src="profile.jpg" alt="Sayful Islam" style="width:100%; height:100%; object-fit:cover;" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                                <div class="user-avatar-fallback" style="display:none; width:100%; height:100%; background:#0284c7; color:#ffffff; align-items:center; justify-content:center; font-weight:800; font-size:14px;">S</div>
                            </div>

                            <div class="user-brand-meta">
                                <span class="user-brand-name">Sayful Islam</span>
                                <span class="user-brand-role">Senior Supervisor</span>
                            </div>

                            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="#64748b" stroke-width="2.2" class="user-brand-chevron"><polyline points="6 9 12 15 18 9"></polyline></svg>
                        </div>

                        <!-- Top-Right Corner Profile Details Dropdown Panel -->
                        <div class="profile-dropdown-menu" id="mainProfileDropdownMenu" role="dialog" aria-modal="false" aria-labelledby="mainProfileDropdownTitle">
                            <!-- Close Button (Top Right of Dropdown) -->
                            <button type="button" class="btn-dropdown-close" onclick="closeProfileDropdown(event)" aria-label="Close Profile" title="Close">
                                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                    <line x1="18" y1="6" x2="6" y2="18"></line>
                                    <line x1="6" y1="6" x2="18" y2="18"></line>
                                </svg>
                            </button>

                            <!-- Circular Profile Photo in Dropdown -->
                            <div class="profile-photo-container">
                                <img src="profile.jpg" alt="Sayful Islam" class="profile-photo" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                                <div class="profile-avatar-fallback" style="display: none;">S</div>
                            </div>

                            <!-- Name & Designation -->
                            <h2 class="profile-name" id="mainProfileDropdownTitle">Sayful Islam</h2>
                            <p class="profile-designation">Senior Supervisor</p>

                            <div class="profile-divider" aria-hidden="true"></div>

                            <!-- Structured Details List -->
                            <div class="profile-info-list">
                                <div class="profile-info-row">
                                    <span class="profile-info-label">ID Number</span>
                                    <span class="profile-info-value">10676</span>
                                </div>
                                <div class="profile-info-row">
                                    <span class="profile-info-label">Phone</span>
                                    <span class="profile-info-value">01796444132</span>
                                </div>
                                <div class="profile-info-row">
                                    <span class="profile-info-label">Join Date</span>
                                    <span class="profile-info-value">01-Feb-2021</span>
                                </div>
                                <div class="profile-info-row">
                                    <span class="profile-info-label">Total Service</span>
                                    <span class="profile-info-value profileServiceDuration" style="color: #0284c7; font-weight: 800;">5 Years, 6 Months, 24 Days</span>
                                </div>
                                <div class="profile-info-row">
                                    <span class="profile-info-label">Section</span>
                                    <span class="profile-info-value">Fan Assemble</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Header Top-Right Corner Logout Button -->
                    <button type="button" class="header-logout-btn" onclick="handleLogout()" title="Logout / Lock Portal">
                        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                            <polyline points="16 17 21 12 16 7"></polyline>
                            <line x1="21" y1="12" x2="9" y2="12"></line>
                        </svg>
                    </button>
                </div>
            </div>
        </header>

        <div class="dashboard-shell-layout">
            <!-- Left Slim Icon Rail matching Reference Screenshot -->
            <aside class="left-icon-rail">
                <button type="button" class="rail-icon-btn btn-rail-main active" id="mainRailBtnMain" onclick="switchToMainInterfaceView()" aria-label="Main Interface">
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" stroke="none">
                        <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                    </svg>
                </button>

                <button type="button" class="rail-icon-btn btn-rail-home" id="mainRailBtnHome" onclick="switchToDepartmentHub()" aria-label="Home">
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                        <polyline points="9 22 9 12 15 12 15 22"></polyline>
                    </svg>
                </button>

                <div class="rail-divider"></div>

                <button type="button" class="rail-icon-btn" onclick="openReportsDrawer()" aria-label="Reports Drawer">
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"></circle>
                        <polyline points="12 6 12 12 16 14"></polyline>
                    </svg>
                </button>

                <a href="master.html" class="rail-icon-btn" aria-label="Master Database">
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <ellipse cx="12" cy="5" rx="9" ry="3"></ellipse>
                        <path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"></path>
                        <path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"></path>
                    </svg>
                </a>

                <button type="button" class="rail-icon-btn" onclick="openSettingsModal()" aria-label="System Settings">
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="3"></circle>
                        <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
                    </svg>
                </button>

                <!-- 🔔 Notification Button with Red Unread Dot -->
                <div style="position:relative;">
                    <button type="button" class="rail-icon-btn" id="mainRailBtnNotif" onclick="toggleSmartNotificationPanel()" aria-label="Notifications">
                        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                            <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
