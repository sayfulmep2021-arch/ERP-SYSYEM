                <div class="rail-spacer" style="flex:1;"></div>
            </aside>

            <!-- Main Interface Canvas Matching Screenshot 2 -->
            <main class="main-interface-viewport">
                <!-- Top Overview Header with Filters -->
                <div class="main-overview-topbar">
                    <div class="main-overview-heading">
                        <span>MEP PRODUCTION &amp; ERP OVERVIEW - REAL-TIME PERFORMANCE</span>
                    </div>
                    <div class="main-overview-filters">
                        <div class="filter-pill-select">
                            <span>All Performance</span>
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
                        </div>
                        <div class="filter-pill-select">
                            <span>All Reports</span>
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
                        </div>
                        <div class="filter-pill-select pill-primary">
                            <span>Barishal Plant</span>
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
                        </div>
                    </div>
                </div>

                <!-- Top 3 KPI Cards Row: Sections 1, 2, 3 -->
                <div class="overview-kpi-row">
                    <!-- ① Card 1: Production Target (40,000 PCS) -->
                    <div class="kpi-gold-card" id="cardProdTarget" title="Monthly Production Target: 40,000 PCS">
                        <div class="kpi-card-head">
                            <span style="letter-spacing:0.4px;">PRODUCTION TARGET</span>
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
                        </div>
                        <div class="kpi-gold-val" id="valProdTarget">40,000 <span style="font-size:0.52em; font-weight:800; letter-spacing:0;">PCS</span></div>
                        <div class="kpi-gold-badge">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                            <span id="lblProdTargetSub">Monthly Production Target (Sep-26)</span>
                        </div>
                    </div>

                    <!-- ② Card 2: Production Achievement (25,000 PCS) -->
                    <div class="kpi-neumorph-card" id="cardProdAchieve" title="Completed Production: 25,000 PCS">
                        <div class="kpi-card-head" style="color:#0f2942;">
                            <span style="letter-spacing:0.4px;">PRODUCTION ACHIEVEMENT</span>
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                        </div>
                        <div class="kpi-green-val" id="valProdAchieve">25,000 <span style="font-size:0.52em; font-weight:800; color:#334155; letter-spacing:0;">PCS</span></div>
                        <div class="kpi-sub-text" style="display:flex; align-items:center; gap:5px; color:#16a34a; font-weight:800;">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="18 15 12 9 6 15"></polyline></svg>
                            <span id="lblProdAchieveSub">Completed Production (Sep-26)</span>
                        </div>
                    </div>

                    <!-- ③ Card 3: Three Branch Production Achievement Bar -->
                    <div class="branch-perf-card" id="cardBranchPerf" title="Branch Performance Bars">
                        <div class="kpi-card-head" style="color:#0f2942; margin-bottom: 2px;">
                            <span style="display:flex; align-items:center; gap:6px; font-weight:900; letter-spacing:0.3px;">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#0284c7" stroke-width="2.5"><line x1="18" y1="20" x2="18" y2="10"></line><line x1="12" y1="20" x2="12" y2="4"></line><line x1="6" y1="20" x2="6" y2="14"></line></svg>
                                BRANCH PERFORMANCE
                            </span>
                            <span style="font-size:0.70rem; font-weight:800; color:#64748b;">Target vs Achievement</span>
                        </div>
                        <div class="branch-bars-stack">
                            <!-- Branch 1: Fan Assemble (75%) -->
                            <div class="branch-bar-row">
                                <div class="branch-bar-meta">
                                    <span>Fan Assemble</span>
                                    <span class="branch-bar-pct text-blue" id="pctFanAssemble">75%</span>
                                </div>
                                <div class="branch-bar-track">
                                    <div class="branch-bar-fill fill-blue" id="barFanAssemble" style="width: 75%;" title="Fan Assemble: 75% Achieved"></div>
                                </div>
                            </div>
                            <!-- Branch 2: Blade & Dimmer (50%) -->
                            <div class="branch-bar-row">
                                <div class="branch-bar-meta">
                                    <span>Blade &amp; Dimmer</span>
                                    <span class="branch-bar-pct text-cyan" id="pctBladeDimmer">50%</span>
                                </div>
                                <div class="branch-bar-track">
                                    <div class="branch-bar-fill fill-cyan" id="barBladeDimmer" style="width: 50%;" title="Blade & Dimmer: 50% Achieved"></div>
                                </div>
                            </div>
                            <!-- Branch 3: Armature & Winding (65%) -->
                            <div class="branch-bar-row">
                                <div class="branch-bar-meta">
                                    <span>Armature &amp; Winding</span>
                                    <span class="branch-bar-pct text-amber" id="pctArmatureWinding">65%</span>
                                </div>
                                <div class="branch-bar-track">
                                    <div class="branch-bar-fill fill-amber" id="barArmatureWinding" style="width: 65%;" title="Armature & Winding: 65% Achieved"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Main Grid: ④ Yearly Graph (Left) + ⑤ Summary & ⑥ Gauge (Right) -->
                <div class="production-perf-layout">
                    
                    <!-- ④ Left Column: Yearly Production Performance Graph -->
                    <div class="perf-graph-column">
                        <div class="yearly-graph-card">
                            <div class="yearly-graph-header">
