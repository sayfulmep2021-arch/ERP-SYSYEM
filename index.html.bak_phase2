                                    <span>YEARLY PRODUCTION PERFORMANCE</span>
                                </div>
                                <div class="yearly-graph-legends">
                                    <div class="legend-chip" title="Monthly Production Target">
                                        <span class="legend-dot-target"></span>
                                        <span style="color:#d97706;">Production Target</span>
                                    </div>
                                    <div class="legend-chip" title="Completed Production Output">
                                        <span class="legend-dot-achieve"></span>
                                        <span style="color:#0284c7;">Production Achievement</span>
                                    </div>
                                    <span class="yearly-pill-chip">Cycle: Jul-26 to Jun-27</span>
                                </div>
                            </div>

                            <!-- SVG Chart Canvas: 12 Months Fiscal Cycle (Jul-26 to Jun-27), Scale 0-50,000 PCS -->
                            <div class="yearly-graph-canvas-wrap">
                                <svg viewBox="0 0 760 250" width="100%" height="100%" preserveAspectRatio="none" style="overflow:visible;">
                                    <defs>
                                        <!-- Gradient Fills -->
                                        <linearGradient id="yearlyAchieveAreaGrad" x1="0" y1="0" x2="0" y2="1">
                                            <stop offset="0%" stop-color="#0284c7" stop-opacity="0.32"/>
                                            <stop offset="100%" stop-color="#bae6fd" stop-opacity="0.02"/>
                                        </linearGradient>
                                        <linearGradient id="yearlyTargetLineGrad" x1="0" y1="0" x2="1" y2="0">
                                            <stop offset="0%" stop-color="#d97706"/>
                                            <stop offset="100%" stop-color="#f59e0b"/>
                                        </linearGradient>
                                        <linearGradient id="yearlyAchieveLineGrad" x1="0" y1="0" x2="1" y2="0">
                                            <stop offset="0%" stop-color="#0284c7"/>
                                            <stop offset="100%" stop-color="#38bdf8"/>
                                        </linearGradient>
                                        <filter id="shadowAchieve" x="-10%" y="-10%" width="120%" height="130%">
