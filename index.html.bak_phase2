    <div class="app-workspace" id="departmentHubView">
        
        <!-- 1. Full-Width Frozen Top Navbar (100vw across entire window from far left corner) -->
        <header class="workspace-navbar" style="background:#ffffff; border-bottom:1.5px solid #cbd5e1; height:48px; min-height:48px; padding:0 16px 0 12px; width:100%; position:sticky; top:0; z-index:1000; flex-shrink:0;">
            <div class="navbar-inner" style="width:100%; display:flex; align-items:center; justify-content:space-between;">
                <!-- Left: Permanent Brand Bar - Smart Time Management (Exclusive) -->
                <div class="smart-brand-card">
                    <span class="smart-brand-text">Smart Time Management</span>
                </div>

                <!-- Far Right Corner: Real-time Live Clock, Profile (NO Bell in Header) -->
                <div class="nav-user-controls" style="display:flex; align-items:center; gap:10px;">
                    <!-- View-Only Mode Status Badge -->
                    <div class="smart-view-only-badge" style="display:none;" title="View-Only Mode: Data entry and editing are disabled">
                        <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                        <span>View Only</span>
                    </div>

                    <div class="live-clock-badge" id="hubLiveClockBadge" title="Live System Day & Time">
                        <span class="smart-cloud-status-badge" id="hubCloudStatusBadge" title="Realtime Cloud: Connected (Live Sync)">
                            <span class="cloud-pulse-dot"></span>
                            <span class="cloud-status-text">Live</span>
                        </span>
                        <div class="live-clock-info">
                            <span class="live-day-text" id="hubLiveDayText">Thursday, 27 Aug 2026</span>
                            <span class="live-time-text" id="hubLiveTimeText">--:--:-- --</span>
                        </div>
                    </div>
                    <div class="profile-dropdown-wrapper">
                        <!-- Top Corner Profile Round Photo & Name Component -->
                        <div class="user-brand-card" 
                             id="hubUserProfileBtn" 
                             onclick="toggleProfileDropdown(event)" 
                             role="button" 
                             tabindex="0" 
                             aria-haspopup="true" 
                             aria-expanded="false" 
                             title="Sayful Islam - Click to view Profile Details" 
                             onkeydown="if(event.key==='Enter'||event.key===' ') toggleProfileDropdown(event)">
                            
                            <!-- Circular Avatar Photo -->
                            <div class="user-avatar-frame" style="width:34px; height:34px; border-radius:50%; overflow:hidden; border:2px solid #0284c7; display:flex; align-items:center; justify-content:center; flex-shrink:0;">
                                <img src="profile.jpg" alt="Sayful Islam" style="width:100%; height:100%; object-fit:cover;" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                                <div class="user-avatar-fallback" style="display:none; width:100%; height:100%; background:#0284c7; color:#ffffff; align-items:center; justify-content:center; font-weight:800; font-size:14px;">S</div>
                            </div>

                            <div class="user-brand-meta">
                                <span class="user-brand-name">Sayful Islam</span>
                                <span class="user-brand-role">Senior Supervisor</span>
                            </div>

                            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="#64748b" stroke-width="2.2" class="user-brand-chevron"><polyline points="6 9 12 15 18 9"></polyline></svg>
                        </div>
                    </div>

                    <!-- Header Top-Right Corner Logout Button -->
                    <button type="button" class="header-logout-btn" onclick="handleLogout()" title="Logout / Lock Portal">
                        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                            <polyline points="16 17 21 12 16 7"></polyline>
                            <line x1="21" y1="12" x2="9" y2="12"></line>
                        </svg>
                    </button>
                </div>
            </div>
        </header>

        <!-- 2. Workspace Body Below Frozen Header: Sidebar + Main Area -->
        <div class="dept-hub-workspace-body">
            
            <!-- Left Pinned Frozen Sidebar Dock (Width: 320px) -->
            <aside class="dept-hub-sidebar-dock" id="hubFrozenSidebar">
                <div class="mep-sidebar-actions" style="display:flex; gap:8px; padding:10px 12px; border-bottom:1.5px solid #e2e8f0; background:#f8fafc;">
                    <button type="button" class="btn-nav-tab btn-nav-main" id="sidebarBtnMain" style="flex:1; justify-content:center; height:36px; padding:0;" onclick="switchToMainInterfaceView()" aria-label="Main Interface">
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" stroke="currentColor" stroke-width="0.8"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
                    </button>
                    <button type="button" class="btn-nav-tab btn-nav-home active" id="sidebarBtnHome" style="flex:1; justify-content:center; height:36px; padding:0;" onclick="switchToDepartmentHub()" aria-label="Home">
                        <svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 10.5L12 3l9 7.5v9.5a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-9.5z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
                    </button>
                </div>

                <!-- Dynamic Sidebar Content (Initially Blank with Placeholder) -->
                <div class="mep-sidebar-body" id="hubSidebarBody" style="flex:1; overflow-y:auto; display:flex; flex-direction:column;">
                    
                    <!-- Promotional Card Banner (Matches User Screenshot Exactly) -->
                    <div class="hub-empty-state" id="hubEmptyState">
                        <div class="hub-promo-card">
                            <div class="hub-promo-img-box">
                                <img src="hub_3d_art_hd.png" alt="Explore &amp; Generate Powerful Reports" class="hub-promo-img">
                            </div>
                            <div class="hub-promo-body">
                                <div class="hub-promo-subtitle">Explore &amp; Generate</div>
                                <h2 class="hub-promo-title">Powerful Reports</h2>
                                <div class="hub-promo-divider"></div>
                                <p class="hub-promo-desc">
                                    Smart. Fast. Accurate.<br>
                                    All Your Reports in One Place.
                                </p>
                                <button type="button" class="hub-promo-btn" onclick="browseAllReportsAction(event)" title="Browse All Available Reports">
                                    <span>Browse All Reports</span>
