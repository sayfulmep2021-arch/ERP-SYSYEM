                                    <path d="M 75 81 C 105 85, 115 125, 135 125 C 165 125, 175 115, 195 115 C 225 115, 235 138, 255 138 C 285 138, 295 155, 315 155 C 345 155, 355 165, 375 165 C 405 165, 415 145, 435 145 C 465 145, 475 110, 495 110 C 525 110, 535 78, 555 78 C 585 78, 595 58, 615 58 C 645 58, 655 45, 675 45 C 705 45, 715 65, 735 65 L 735 225 L 75 225 Z" fill="url(#yearlyAchieveAreaGrad)"/>

